{% doc %}
  @prompt
    I want to create a size guide table, which is interactive. you can switch between Inches & Centimeters
    
    I need the size guide to also have UK / EU / USA sizes as well. Below is the data for UK size guide. 
    
    UK | Chest (Inches) | Chest (CM) | Waist (Inches) | Waist (CM) | Hips (Inches) | Hips (CM)
    8  | 33             | 83         | 26             | 65         | 35            | 88.5
    10 | 35             | 88         | 28             | 70         | 37            | 93.5
    12 | 37             | 93         | 30             | 75         | 39            | 98.5
    14 | 39             | 98         | 31             | 80         | 41            | 103.5
    16 | 41             | 103        | 33             | 85         | 43            | 108.5
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-guide-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    display: block;
  }

  .ai-size-guide-header-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-size-guide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-size-guide-controls-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .ai-size-guide-unit-toggle-{{ ai_gen_id }} {
    display: inline-flex;
    background-color: {{ block.settings.toggle_bg_color }};
    border-radius: {{ block.settings.toggle_border_radius }}px;
    padding: 4px;
    gap: 4px;
  }

  .ai-size-guide-unit-btn-{{ ai_gen_id }} {
    padding: 8px 16px;
    border: none;
    background: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    border-radius: {{ block.settings.toggle_border_radius | minus: 2 }}px;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .ai-size-guide-unit-btn-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.toggle_active_bg }};
    color: {{ block.settings.toggle_active_text }};
  }

  .ai-size-guide-table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-size-guide-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    font-size: {{ block.settings.table_text_size }}px;
  }

  .ai-size-guide-table-{{ ai_gen_id }} th,
  .ai-size-guide-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-size-guide-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
  }

  .ai-size-guide-table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.cell_bg_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-size-guide-table-{{ ai_gen_id }} tbody tr:hover td {
    background-color: {{ block.settings.row_hover_color }};
  }

  .ai-size-guide-measurement-{{ ai_gen_id }} {
    display: none;
  }

  .ai-size-guide-measurement-{{ ai_gen_id }}.active {
    display: table-cell;
  }

  @media screen and (max-width: 749px) {
    .ai-size-guide-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-size-guide-table-{{ ai_gen_id }} {
      font-size: {{ block.settings.table_text_size | times: 0.9 }}px;
    }

    .ai-size-guide-table-{{ ai_gen_id }} th,
    .ai-size-guide-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<size-guide-{{ ai_gen_id }} class="ai-size-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-size-guide-header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h3 class="ai-size-guide-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
    {% endif %}

    <div class="ai-size-guide-controls-{{ ai_gen_id }}">
      <div class="ai-size-guide-unit-toggle-{{ ai_gen_id }}">
        <button
          class="ai-size-guide-unit-btn-{{ ai_gen_id }} active"
          data-unit="inches"
          aria-pressed="true"
        >
          {{ block.settings.inches_label }}
        </button>
        <button
          class="ai-size-guide-unit-btn-{{ ai_gen_id }}"
          data-unit="cm"
          aria-pressed="false"
        >
          {{ block.settings.cm_label }}
        </button>
      </div>
    </div>
  </div>

  <div class="ai-size-guide-table-wrapper-{{ ai_gen_id }}">
    <table class="ai-size-guide-table-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th>{{ block.settings.uk_label }}</th>
          <th>{{ block.settings.eu_label }}</th>
          <th>{{ block.settings.us_label }}</th>
          <th class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">
            {{ block.settings.chest_label }}
          </th>
          <th class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">
            {{ block.settings.chest_label }}
          </th>
          <th class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">
            {{ block.settings.waist_label }}
          </th>
          <th class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">
            {{ block.settings.waist_label }}
          </th>
          <th class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">
            {{ block.settings.hips_label }}
          </th>
          <th class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">
            {{ block.settings.hips_label }}
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>8</td>
          <td>36</td>
          <td>4</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">33</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">83</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">26</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">65</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">35</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">88.5</td>
        </tr>
        <tr>
          <td>10</td>
          <td>38</td>
          <td>6</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">35</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">88</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">28</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">70</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">37</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">93.5</td>
        </tr>
        <tr>
          <td>12</td>
          <td>40</td>
          <td>8</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">37</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">93</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">30</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">75</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">39</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">98.5</td>
        </tr>
        <tr>
          <td>14</td>
          <td>42</td>
          <td>10</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">39</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">98</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">31</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">80</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">41</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">103.5</td>
        </tr>
        <tr>
          <td>16</td>
          <td>44</td>
          <td>12</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">41</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">103</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">33</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">85</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }} active" data-unit="inches">43</td>
          <td class="ai-size-guide-measurement-{{ ai_gen_id }}" data-unit="cm">108.5</td>
        </tr>
      </tbody>
    </table>
  </div>
</size-guide-{{ ai_gen_id }}>

<script>
  (function() {
    class SizeGuide{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentUnit = 'inches';
      }

      connectedCallback() {
        this.unitButtons = this.querySelectorAll('.ai-size-guide-unit-btn-{{ ai_gen_id }}');
        this.measurementCells = this.querySelectorAll('.ai-size-guide-measurement-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.unitButtons.forEach(button => {
          button.addEventListener('click', () => {
            const unit = button.getAttribute('data-unit');
            this.switchUnit(unit);
          });
        });
      }

      switchUnit(unit) {
        if (this.currentUnit === unit) return;
        
        this.currentUnit = unit;
        
        this.unitButtons.forEach(btn => {
          const isActive = btn.getAttribute('data-unit') === unit;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', isActive);
        });
        
        this.measurementCells.forEach(cell => {
          const cellUnit = cell.getAttribute('data-unit');
          cell.classList.toggle('active', cellUnit === unit);
        });
      }
    }

    customElements.define('size-guide-{{ ai_gen_id }}', SizeGuide{{ ai_gen_id }});
  })();
</script>

