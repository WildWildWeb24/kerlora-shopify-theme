{% doc %}
  @prompt
    a section that shows the name of the collection and breadcrumbs. I want to have options to change the font size of the title font
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-banner__container-{{ ai_gen_id }} {
    max-width: {{ settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-banner__breadcrumbs-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.breadcrumb_spacing }}px;
  }

  .ai-collection-banner__breadcrumb-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: {{ block.settings.breadcrumb_font_size }}px;
    color: {{ block.settings.breadcrumb_color }};
  }

  .ai-collection-banner__breadcrumb-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-collection-banner__breadcrumb-link-{{ ai_gen_id }} {
    color: {{ block.settings.breadcrumb_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-collection-banner__breadcrumb-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.breadcrumb_hover_color }};
  }

  .ai-collection-banner__breadcrumb-separator-{{ ai_gen_id }} {
    color: {{ block.settings.breadcrumb_color }};
    opacity: 0.5;
  }

  .ai-collection-banner__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.title_alignment }};
    font-weight: {{ block.settings.title_font_weight }};
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-banner__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.7 }}px;
    }

    .ai-collection-banner__breadcrumb-list-{{ ai_gen_id }} {
      font-size: {{ block.settings.breadcrumb_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-banner__container-{{ ai_gen_id }}">
    {% if block.settings.show_breadcrumbs %}
      <nav class="ai-collection-banner__breadcrumbs-{{ ai_gen_id }}" aria-label="Breadcrumb">
        <ol class="ai-collection-banner__breadcrumb-list-{{ ai_gen_id }}">
          <li class="ai-collection-banner__breadcrumb-item-{{ ai_gen_id }}">
            <a href="/" class="ai-collection-banner__breadcrumb-link-{{ ai_gen_id }}">
              {{ block.settings.home_text }}
            </a>
            <span class="ai-collection-banner__breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
              {{ block.settings.separator }}
            </span>
          </li>
          <li class="ai-collection-banner__breadcrumb-item-{{ ai_gen_id }}">
            <span aria-current="page">{{ collection.title }}</span>
          </li>
        </ol>
      </nav>
    {% endif %}

    {% if block.settings.show_title %}
      <h1 class="ai-collection-banner__title-{{ ai_gen_id }}">
        {{ collection.title }}
      </h1>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home text",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "/"
    },
    {
      "type": "range",
      "id": "breadcrumb_font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "breadcrumb_spacing",
      "label": "Spacing below",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "breadcrumb_hover_color",
      "label": "Hover color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Collection title"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Font size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text color",
      "default": "#222222"
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
