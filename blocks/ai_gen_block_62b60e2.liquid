{% doc %}
  @prompt
    Create a newsletter signup popup matching the existing Kerlora theme styling. Display it only on the homepage, immediately when the page loads. Use heading 'Join the Kerlora newsletter', body 'Sign up for news, new arrivals and updates from Kerlora.', one email address field and a 'Sign up' button. Connect submissions to the store's newsletter subscription functionality, with clear signup intent, validation and success feedback. Include an accessible close button, keyboard-friendly behaviour and a mobile-friendly layout. Remember dismissal so it does not reopen on every homepage visit, and don't show it again after successful signup. Make the text and display settings editable. Do not offer a discount, change the existing inline newsletter forms, cookie consent banner, tracking or any unrelated theme content.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture ai_form_id %}ai-newsletter-form-{{ ai_gen_id }}{% endcapture %}

{% if request.page_type == 'index' %}
  {% style %}
    .ai-newsletter-popup-{{ ai_gen_id }} { display: block; width: 100%; }
    .ai-newsletter-popup-{{ ai_gen_id }}[hidden] { display: none; }
    .ai-newsletter-popup-{{ ai_gen_id }}__overlay { position: fixed; inset: 0; z-index: 9998; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.58); }
    .ai-newsletter-popup-{{ ai_gen_id }}__dialog { position: relative; box-sizing: border-box; width: {{ block.settings.desktop_width_percent }}%; max-width: 520px; max-height: calc(100vh - 40px); overflow-y: auto; padding: 48px 40px 40px; border: 1px solid #dedede; border-radius: 5px; background: #fff; color: #222; box-shadow: 0 18px 50px rgba(0,0,0,.2); font-family: inherit; }
    .ai-newsletter-popup-{{ ai_gen_id }}__heading { margin: 0 36px 12px 0; color: #222; font-family: inherit; font-size: clamp(24px,5vw,32px); line-height: 1.2; }
    .ai-newsletter-popup-{{ ai_gen_id }}__body { margin: 0 0 24px; color: #444; font-size: 16px; line-height: 1.6; }
    .ai-newsletter-popup-{{ ai_gen_id }}__close { position: absolute; top: 14px; right: 14px; display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; padding: 0; border: 1px solid #777; border-radius: 50%; background: #fff; color: #222; cursor: pointer; }
    .ai-newsletter-popup-{{ ai_gen_id }}__close svg { width: 18px; height: 18px; }
    .ai-newsletter-popup-{{ ai_gen_id }}__field { display: flex; flex-direction: column; gap: 10px; }
    .ai-newsletter-popup-{{ ai_gen_id }}__input { box-sizing: border-box; width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid #767676; border-radius: 5px; background: #fff; color: #222; font: inherit; }
    .ai-newsletter-popup-{{ ai_gen_id }}__button { min-height: 50px; padding: 12px 22px; border: 1px solid #000; border-radius: 5px; background: #000; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
    .ai-newsletter-popup-{{ ai_gen_id }}__button:hover { background: #222; }
    .ai-newsletter-popup-{{ ai_gen_id }}__status { margin: 14px 0 0; color: #222; font-size: 14px; line-height: 1.5; }
    .ai-newsletter-popup-{{ ai_gen_id }} :focus-visible { outline: 3px solid #216eaa; outline-offset: 3px; }
    @media screen and (max-width: 600px) { .ai-newsletter-popup-{{ ai_gen_id }}__overlay { padding: 16px; } .ai-newsletter-popup-{{ ai_gen_id }}__dialog { width: 100%; max-width: none; padding: 48px 24px 28px; } .ai-newsletter-popup-{{ ai_gen_id }}__field { gap: 12px; } }
  {% endstyle %}

  <newsletter-popup-{{ ai_gen_id }} class="ai-newsletter-popup-{{ ai_gen_id }}" data-storage-key="kerlora-newsletter-popup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-newsletter-popup-{{ ai_gen_id }}__overlay" hidden>
      <section class="ai-newsletter-popup-{{ ai_gen_id }}__dialog" role="dialog" aria-modal="true" aria-labelledby="ai-newsletter-heading-{{ ai_gen_id }}" aria-describedby="ai-newsletter-body-{{ ai_gen_id }}">
        <button class="ai-newsletter-popup-{{ ai_gen_id }}__close" type="button" aria-label="{{ block.settings.close_label | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></button>
        <h2 class="ai-newsletter-popup-{{ ai_gen_id }}__heading" id="ai-newsletter-heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
        <p class="ai-newsletter-popup-{{ ai_gen_id }}__body" id="ai-newsletter-body-{{ ai_gen_id }}">{{ block.settings.body | escape }}</p>
        {% form 'customer', id: ai_form_id %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <div class="ai-newsletter-popup-{{ ai_gen_id }}__field">
            <label class="visually-hidden" for="ai-newsletter-email-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
            <input class="ai-newsletter-popup-{{ ai_gen_id }}__input" id="ai-newsletter-email-{{ ai_gen_id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ block.settings.email_placeholder | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true" {% if form.errors %}aria-invalid="true" aria-describedby="ai-newsletter-status-{{ ai_gen_id }}"{% endif %}>
            <button class="ai-newsletter-popup-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
          </div>
          {% if form.errors %}<p class="ai-newsletter-popup-{{ ai_gen_id }}__status" id="ai-newsletter-status-{{ ai_gen_id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% elsif form.posted_successfully? %}<p class="ai-newsletter-popup-{{ ai_gen_id }}__status" id="ai-newsletter-status-{{ ai_gen_id }}" role="status">{{ block.settings.success_message | escape }}</p>{% endif %}
        {% endform %}
      </section>
    </div>
  </newsletter-popup-{{ ai_gen_id }}>
  <script>
    (function() {
      const tagName = 'newsletter-popup-{{ ai_gen_id }}';
      if (customElements.get(tagName)) return;
      class NewsletterPopup extends HTMLElement {
        connectedCallback() {
          this.overlay = this.querySelector('.ai-newsletter-popup-{{ ai_gen_id }}__overlay');
          this.dialog = this.querySelector('.ai-newsletter-popup-{{ ai_gen_id }}__dialog');
          this.closeButton = this.querySelector('.ai-newsletter-popup-{{ ai_gen_id }}__close');
          this.form = this.querySelector('form');
          this.key = this.dataset.storageKey;
          this.handleKeydown = this.handleKeydown.bind(this);
          let stored;
          try { stored = localStorage.getItem(this.key); } catch (error) {}
          if (this.form && this.form.querySelector('[role="status"]')) { try { localStorage.setItem(this.key, 'success'); } catch (error) {} return; }
          if (stored) return;
          this.overlay.hidden = false;
          this.closeButton.focus();
          this.closeButton.addEventListener('click', () => this.dismiss());
          this.overlay.addEventListener('click', (event) => { if (event.target === this.overlay) this.dismiss(); });
          document.addEventListener('keydown', this.handleKeydown);
          if (this.form) this.form.addEventListener('submit', () => { if (this.form.checkValidity()) { try { localStorage.setItem(this.key, 'success'); } catch (error) {} } });
        }
        dismiss() { this.overlay.hidden = true; try { localStorage.setItem(this.key, 'dismissed'); } catch (error) {} document.removeEventListener('keydown', this.handleKeydown); }
        handleKeydown(event) {
          if (event.key === 'Escape') { this.dismiss(); return; }
          if (event.key !== 'Tab') return;
          const focusable = this.dialog.querySelectorAll('button, input:not([type="hidden"]), a[href], [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;
          const first = focusable[0], last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      }
      customElements.define(tagName, NewsletterPopup);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Kerlora newsletter" },
    { "type": "textarea", "id": "body", "label": "Message", "default": "Sign up for news, new arrivals and updates from Kerlora." },
    { "type": "text", "id": "email_label", "label": "Email field label", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for signing up. Your subscription has been received." },
    { "type": "text", "id": "close_label", "label": "Close button label", "default": "Close newsletter signup" },
    { "type": "header", "content": "Display" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Newsletter popup" }],
  "tag": null,
  "class": "newsletter-popup-block"
}
{% endschema %}