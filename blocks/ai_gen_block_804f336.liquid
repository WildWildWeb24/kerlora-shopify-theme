{% doc %}
  @prompt
    two column with image upload feature in each., Each col should have the feature to link to a collection page, The heading should be on top on the image aligned left-bottom with some padding. 
    
    H2 font, The heading div width should be max width to 370px 
    Add a button for each below the heading. , remove the black transparent overly 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-two-column__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-two-column__column-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-two-column__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.placeholder_bg_color }};
  }

  .ai-two-column__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-two-column__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg_color }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-two-column__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    border-radius: 0 0 {{ block.settings.image_border_radius }}px {{ block.settings.image_border_radius }}px;
    max-width: 380px;
  }

  .ai-two-column__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.button_spacing }}px 0;
    font-weight: 500;
    line-height: 54px;
    letter-spacing: -1px;
  }

  .ai-two-column__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: {{ block.settings.text_spacing }}px 0 0 0;
  }

  .ai-two-column__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-two-column__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-two-column__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-two-column-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-two-column__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.9);
    }

    .ai-two-column__content-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<two-column-block-{{ ai_gen_id }} class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column__container-{{ ai_gen_id }}">
    <div class="ai-two-column__column-{{ ai_gen_id }}">
      <div class="ai-two-column__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 1000 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            class="ai-two-column__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% else %}
          <div class="ai-two-column__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.heading_1 != blank or block.settings.text_1 != blank or block.settings.button_label_1 != blank %}
          <div class="ai-two-column__content-{{ ai_gen_id }}">
            {% if block.settings.heading_1 != blank %}
              <h2 class="ai-two-column__heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h2>
            {% endif %}
            {% if block.settings.text_1 != blank %}
              <div class="ai-two-column__text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
            {% endif %}
            {% if block.settings.button_label_1 != blank %}
              <a 
                href="{% if block.settings.collection_1 %}{{ block.settings.collection_1.url }}{% else %}{{ block.settings.button_link_1 }}{% endif %}" 
                class="ai-two-column__button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_label_1 }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-two-column__column-{{ ai_gen_id }}">
      <div class="ai-two-column__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 1000 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            class="ai-two-column__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% else %}
          <div class="ai-two-column__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.heading_2 != blank or block.settings.text_2 != blank or block.settings.button_label_2 != blank %}
          <div class="ai-two-column__content-{{ ai_gen_id }}">
            {% if block.settings.heading_2 != blank %}
              <h2 class="ai-two-column__heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h2>
            {% endif %}
            {% if block.settings.text_2 != blank %}
              <div class="ai-two-column__text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
            {% endif %}
            {% if block.settings.button_label_2 != blank %}
              <a 
                href="{% if block.settings.collection_2 %}{{ block.settings.collection_2.url }}{% else %}{{ block.settings.button_link_2 }}{% endif %}" 
                class="ai-two-column__button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_label_2 }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</two-column-block-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('two-column-block-{{ ai_gen_id }}', TwoColumnBlock{{ ai_gen_id }});
  })();
</script>

