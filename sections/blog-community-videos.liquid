{{ 'component-community-videos.css' | asset_url | stylesheet_tag }}

<section class="community-videos" id="community-videos-{{ section.id }}">
  <div class="community-videos__container page-width">

    <div class="community-videos__header">
      <h2 class="community-videos__heading">{{ section.settings.heading | escape }}</h2>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="community-videos__wrapper">

        <button
          type="button"
          class="community-videos__arrow community-videos__arrow--prev"
          data-community-videos-prev
          aria-label="Previous videos"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="community-videos__track" data-community-videos-track>
          {% for block in section.blocks %}
            <div class="community-videos__card" {{ block.shopify_attributes }}>
              {% if block.settings.video != blank %}
                <div class="community-videos__media" >
                  {{
                    block.settings.video
                    | video_tag:
                    class: 'community-videos__video',
                    controls: false,
                    muted: true,
                    loop: true,
                    playsinline: true,
                    autoplay: true,
                    preload: 'auto'
                  }}
                </div>
              {% else %}
                <div class="community-videos__media community-videos__media--empty">
                  <span>Add a video</span>
                </div>
              {% endif %}

              {% if block.settings.caption != blank %}
                <div class="community-videos__caption">
                  <p>{{ block.settings.caption | escape }}</p>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <button
          type="button"
          class="community-videos__arrow community-videos__arrow--next"
          data-community-videos-next
          aria-label="Next videos"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

      </div>
    {% else %}
      <p class="community-videos__empty">Add video blocks in the section settings to populate this gallery.</p>
    {% endif %}

  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('community-videos-{{ section.id }}');
    if (!section) return;

    var track = section.querySelector('[data-community-videos-track]');
    var prevBtn = section.querySelector('[data-community-videos-prev]');
    var nextBtn = section.querySelector('[data-community-videos-next]');
    if (!track) return;

    function scrollByPage(direction) {
      var amount = track.clientWidth;
      track.scrollBy({ left: direction * amount, behavior: 'smooth' });
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollByPage(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollByPage(1); });
  })();
</script>

{% schema %}
{
  "name": "Community: Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Moments from the Community"
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "e.g. @handle or a short label shown under the video.",
          "default": "@kerlora"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community: Videos",
      "blocks": [
        { "type": "video_item" },
        { "type": "video_item" },
        { "type": "video_item" },
        { "type": "video_item" }
      ]
    }
  ]
}
{% endschema %}