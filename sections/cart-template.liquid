<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- liquid
  if linklists['gift-wrapping'].links != blank and linklists['gift-wrapping'].links.first.type == 'product_link'
    assign gift_wrapping = linklists['gift-wrapping'].links.first

    assign gift_wrap_id = gift_wrapping.object.variants.first.id
    assign gift_wraps_in_cart = 0
    for item in cart.items
      if item.id == gift_wrap_id
        assign gift_wraps_in_cart = item.quantity
        break
      endif
    endfor
    assign items_in_cart = cart.item_count | minus: gift_wraps_in_cart
  endif
-%}

<style>
  #cart-template-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }
  {% if section.settings.heading_color != blank %}
    #cart-template-{{ section.id }} .kerlora-cart-title {
      color: {{ section.settings.heading_color }} !important;
    }
  {% endif %}
  {% if section.settings.subtitle_color != blank %}
    #cart-template-{{ section.id }} .kerlora-cart-subtitle {
      color: {{ section.settings.subtitle_color }} !important;
    }
  {% endif %}
  {% if section.settings.summary_card_bg != blank %}
    #cart-template-{{ section.id }} .kerlora-payment-card {
      background-color: {{ section.settings.summary_card_bg }} !important;
    }
  {% endif %}
  {% if section.settings.summary_card_border != blank %}
    #cart-template-{{ section.id }} .kerlora-payment-card {
      border-color: {{ section.settings.summary_card_border }} !important;
    }
  {% endif %}
  {% if section.settings.checkout_btn_bg != blank %}
    #cart-template-{{ section.id }} .kerlora-checkout-btn {
      background-color: {{ section.settings.checkout_btn_bg }} !important;
    }
  {% endif %}
  {% if section.settings.checkout_btn_color != blank %}
    #cart-template-{{ section.id }} .kerlora-checkout-btn {
      color: {{ section.settings.checkout_btn_color }} !important;
    }
  {% endif %}
</style>

<div id="cart-template-{{ section.id }}" class="container">
  <!-- Cart Header Area -->
  <div class="kerlora-cart-header">
    {% if section.settings.show_back_link %}
      <a href="{{ routes.all_products_collection_url }}" class="kerlora-cart-back">
        &larr; {{ section.settings.back_link_text | default: 'Continue shopping' }}
      </a>
    {% endif %}
    <h1 class="kerlora-cart-title">{{ section.settings.heading | default: 'Shopping Cart' }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="kerlora-cart-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <m-cart class="m-cart{% if cart == empty %} m-cart--empty{% endif %}" id="MinimogCart">
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="m-cart__grid kerlora-cart-grid">
        <!-- Left Column: Cart Items -->
        <div class="m-cart__left-column">
          <div class="m-cart__wrapper m:w-full">
            <div class="m-cart__header m:flex kerlora-cart-table-header">
              <div class="m-cart__column m-cart__column--product">{{ 'cart.label.product' | t | upcase }}</div>
              <div class="m-cart__column m-cart__column--price">{{ 'cart.label.price' | t | upcase }}</div>
              <div class="m-cart__column m-cart__column--quantity m:hidden md:m:block">{{ 'cart.label.quantity' | t | upcase }}</div>
              <div class="m-cart__column m-cart__column--subtotal m:text-right m:hidden md:m:block">
                {{ 'cart.label.total' | t | upcase }}
              </div>
            </div>

            <div class="m-cart__body" data-minimog-cart-items>
              {%- if cart.item_count > 0 -%}
                <div class="m-cart__items">
                  {% for item in cart.items %}
                    {% render 'cart-line-item', item: item %}
                  {% endfor %}
                </div>

                <!-- Table Bottom Row Actions -->
                <div class="kerlora-cart-table-bottom">
                  {% if section.settings.show_back_link %}
                    <a href="{{ routes.all_products_collection_url }}" class="kerlora-cart-bottom-back">
                      &larr; {{ section.settings.back_link_text | default: 'Continue shopping' }}
                    </a>
                  {% endif %}
                  {% if section.settings.show_clear_cart %}
                    <a href="{{ routes.cart_clear_url }}" class="kerlora-cart-clear-btn" data-cart-clear>
                      Clear cart
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </a>
                  {% endif %}
                </div>
              {%- else -%}
                <div class="m-cart__empty">
                  <h3 class="m:text-center m:text-xl">
                    {{ 'cart.general.empty' | t }}
                    <a href="{{ routes.all_products_collection_url }}" class="m-text-link">
                      {{ 'layout.back_to_shopping' | t }}
                    </a>
                  </h3>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

        <!-- Right Column: Payment & Summary Sidebar Card -->
        <div class="m-cart__right-column">
          <div class="kerlora-payment-card" id="MinimogCartFooter">
            <!-- Free Shipping Bar -->
            {% render 'free-shipping-goal' %}

            <!-- Discount Code Input -->
            <div class="kerlora-discount-box">
              <input type="text" name="discount" placeholder="Discount code" class="kerlora-discount-input" autocomplete="off">
              <button type="button" class="kerlora-discount-apply-btn" data-discount-apply-btn>Apply</button>
            </div>

            <!-- Gifting Personal Note Accordion -->
            <details class="kerlora-gifting-accordion">
              <summary class="kerlora-gifting-summary">
                <span>🎁 Gifting this order? Add a personal note</span>
                <span class="kerlora-gifting-arrow">&or;</span>
              </summary>
              <div class="kerlora-gifting-content">
                <textarea name="attributes[gift-note]" class="kerlora-gifting-textarea" placeholder="Enter your gift message here...">{{ cart.attributes.gift-note }}</textarea>
              </div>
            </details>

            <!-- Subtotal & Shipping Breakdown -->
            <div class="kerlora-summary-rows">
              <div class="kerlora-summary-row">
                <span class="kerlora-summary-label">Subtotal ({{ cart.item_count }} items)</span>
                <span class="kerlora-summary-value" data-cart-subtotal-price>{{ cart.total_price | money }}</span>
              </div>
              <div class="kerlora-summary-row">
                <span class="kerlora-summary-label">Shipping <span title="Shipping calculated at checkout" style="cursor:help;">&#9432;</span></span>
                <span class="kerlora-summary-subtext">Calculated at checkout</span>
              </div>
            </div>

            <!-- Total Row -->
            <div class="kerlora-total-row">
              <span class="kerlora-total-label">Total</span>
              <span class="kerlora-total-value" data-cart-subtotal-price>{{ cart.total_price | money }}</span>
            </div>

            <!-- Checkout Primary Button -->
            <div class="kerlora-checkout-wrapper">
              <button type="submit" name="checkout" class="kerlora-checkout-btn">
                Checkout securely &rarr;
              </button>
            </div>

            <!-- Accelerated Payment Badges -->
            <div class="kerlora-accel-payments">
              <div class="kerlora-payment-pill kerlora-pay-shoppay">shop<span style="font-style:italic;">Pay</span></div>
              <div class="kerlora-payment-pill kerlora-pay-gpay"><span style="color:#4285F4">G</span> <span style="color:#111">Pay</span></div>
              <div class="kerlora-payment-pill kerlora-pay-paypal">Pay<em>Pal</em></div>
            </div>

            <!-- Trust Badges Footer -->
            <div class="kerlora-trust-badges">
              <span class="kerlora-trust-item">&#128274; Secure checkout</span>
              <span class="kerlora-trust-sep">|</span>
              <span class="kerlora-trust-item">&#128666; Easy returns</span>
              <span class="kerlora-trust-sep">|</span>
              <span class="kerlora-trust-item">&#127793; Sustainable packaging</span>
            </div>
          </div>
        </div>
      </div>
    </form>
    {% if section.settings.show_upsell %}
      {% render 'cart-upsell', context: 'page', heading: section.settings.upsell_heading, subtitle: section.settings.upsell_subtitle, custom_collection: section.settings.upsell_collection %}
    {% endif %}
  </m-cart>
</div>

{% schema %}
{
  "name": "Cart template",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shopping Cart"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "You're one step closer to feeling great."
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show 'Continue shopping' link",
      "default": true
    },
    {
      "type": "text",
      "id": "back_link_text",
      "label": "'Continue shopping' link text",
      "default": "Continue shopping"
    },
    {
      "type": "checkbox",
      "id": "show_clear_cart",
      "label": "Show 'Clear cart' button",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "summary_card_bg",
      "label": "Summary card background",
      "default": "#F8F7F5"
    },
    {
      "type": "color",
      "id": "summary_card_border",
      "label": "Summary card border",
      "default": "#EAE6DF"
    },
    {
      "type": "color",
      "id": "checkout_btn_bg",
      "label": "Checkout button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "checkout_btn_color",
      "label": "Checkout button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Product Recommendations ('You may also like')"
    },
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "Show recommendations section inside cart",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Recommendations Heading",
      "default": "You may also like"
    },
    {
      "type": "textarea",
      "id": "upsell_subtitle",
      "label": "Recommendations Subtitle",
      "default": "Check out product recommendations tailored to you."
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Recommendations Collection"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ]
}
{% endschema %}
