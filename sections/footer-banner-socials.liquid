<style>
  .m-footer-bs--{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__container {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    align-items: stretch;
    width: 100%;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__col {
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Banner Block (50% Width on Desktop - Columns 1 & 2) */
  .m-footer-bs--{{ section.id }} .m-footer-bs__banner {
    padding: 0;
    position: relative;
    min-height: 220px;
    width: 100%;
    overflow: hidden;
    border-right: 1px solid {{ section.settings.border_color }};
    background-color: #D4DFE8;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__banner-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 1;
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__banner-content {
    position: relative;
    z-index: 2;
    padding: 36px 40px;
    margin-left: auto;
    max-width: 50%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__banner-title {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: none;
    line-height: 1.35;
    margin: 0 0 14px 0;
    color: {{ section.settings.heading_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__line {
    display: block;
    width: 32px;
    height: 1px;
    background-color: {{ section.settings.heading_color }};
  }

  /* Social Links Block (25% Width on Desktop) */
  .m-footer-bs--{{ section.id }} .m-footer-bs__socials {
    border-right: 1px solid {{ section.settings.border_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__subheading {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: none;
    margin-bottom: 8px;
    color: {{ section.settings.heading_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__desc {
    font-size: 14px;
    line-height: 1.4;
    margin: 0 0 20px 0;
    color: {{ section.settings.link_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-socials__list {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.2vw, 12px);
    flex-wrap: nowrap;
    width: 100%;
  }

  .m-footer-bs--{{ section.id }} .m-footer-socials__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(28px, 4vw, 38px);
    height: clamp(28px, 4vw, 38px);
    border-radius: 50%;
    border: 1px solid {{ section.settings.heading_color }};
    color: {{ section.settings.heading_color }};
    text-decoration: none;
    flex-shrink: 1;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .m-footer-bs--{{ section.id }} .m-footer-socials__link:hover {
    background-color: {{ section.settings.heading_color }};
    color: {{ section.settings.bg_color }};
  }

  .m-footer-bs--{{ section.id }} .m-footer-socials__link svg {
    width: clamp(13px, 2vw, 18px);
    height: clamp(13px, 2vw, 18px);
    stroke: currentColor;
    fill: none;
  }

  /* Quote Block (25% Width on Desktop) */
  .m-footer-bs--{{ section.id }} .m-footer-bs__quote {
    justify-content: center;
  }

  .m-footer-bs--{{ section.id }} .m-footer-bs__quote-title {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: none;
    line-height: 1.45;
    margin: 0 0 16px 0;
    color: {{ section.settings.heading_color }};
    max-width: 200px;
  }

  /* Mobile & Tablet Layout (<= 989px) */
  @media screen and (max-width: 989px) {
    .m-footer-bs--{{ section.id }} .m-footer-bs__grid {
      grid-template-columns: 1fr 1fr;
    }

    .m-footer-bs--{{ section.id }} .m-footer-bs__banner {
      grid-column: span 2;
      min-height: 180px;
      border-right: none;
      border-bottom: 1px solid {{ section.settings.border_color }};
    }

    .m-footer-bs--{{ section.id }} .m-footer-bs__banner-content {
      padding: 24px;
      max-width: 60%;
    }

    .m-footer-bs--{{ section.id }} .m-footer-bs__socials {
      grid-column: span 1;
      padding: 24px 16px;
      border-right: 1px solid {{ section.settings.border_color }};
    }

    .m-footer-bs--{{ section.id }} .m-footer-bs__quote {
      grid-column: span 1;
      padding: 24px 16px;
      border-right: none;
    }

    .m-footer-bs--{{ section.id }} .m-footer-bs__quote-title {
      font-size: 13px;
      letter-spacing: 1.5px;
    }
  }
</style>

<div class="m-footer-bs m-footer-bs--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="footer-banner-socials">
  <div class="m-footer-bs__container">
    <div class="m-footer-bs__grid">
      
      <!-- Banner Block (Columns 1 & 2 - Merged 50%) -->
      <div class="m-footer-bs__col m-footer-bs__banner">
        {%- if section.settings.banner_image != blank -%}
          <img
            src="{{ section.settings.banner_image | image_url: width: 1200 }}"
            alt="{{ section.settings.banner_heading | escape }}"
            loading="lazy"
            class="m-footer-bs__banner-img"
          >
        {%- endif -%}
        <div class="m-footer-bs__banner-content">
          {%- if section.settings.banner_heading != blank -%}
            <h3 class="m-footer-bs__banner-title">{{ section.settings.banner_heading | newline_to_br }}</h3>
            <span class="m-footer-bs__line"></span>
          {%- endif -%}
        </div>
      </div>

      <!-- Social Links Block (Column 3) -->
      <div class="m-footer-bs__col m-footer-bs__socials">
        {%- if section.settings.social_heading != blank -%}
          <div class="m-footer-bs__subheading">{{ section.settings.social_heading }}</div>
        {%- endif -%}

        {%- if section.settings.social_desc != blank -%}
          <p class="m-footer-bs__desc">{{ section.settings.social_desc }}</p>
        {%- endif -%}

        <div class="m-footer-socials__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social_link' -%}
              <a
                href="{{ block.settings.url | default: '#' }}"
                class="m-footer-socials__link"
                title="{{ block.settings.title | escape }}"
                target="_blank"
                rel="noopener"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.svg_code != blank -%}
                  {{ block.settings.svg_code }}
                {%- elsif block.settings.icon_image != blank -%}
                  <img src="{{ block.settings.icon_image | image_url: width: 40 }}" alt="{{ block.settings.title | escape }}" width="18" height="18">
                {%- else -%}
                  {%- case block.settings.platform -%}
                    {%- when 'instagram' -%}
                      <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    {%- when 'facebook' -%}
                      <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    {%- when 'tiktok' -%}
                      <svg viewBox="0 0 24 24"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
                    {%- when 'youtube' -%}
                      <svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                    {%- when 'pinterest' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.63 7.87 6.34 9.32-.09-.79-.17-2 .04-2.86.19-.79 1.23-5.21 1.23-5.21s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.57 2.26-.87 3.51-.25 1.05.53 1.91 1.56 1.91 1.88 0 3.32-1.98 3.32-4.84 0-2.53-1.82-4.3-4.41-4.3-3.01 0-4.78 2.26-4.78 4.59 0 .91.35 1.88.79 2.41.09.11.1.2.07.31l-.3 1.24c-.05.21-.17.26-.39.16-1.44-.67-2.34-2.78-2.34-4.47 0-3.64 2.65-6.99 7.63-6.99 4.01 0 7.12 2.86 7.12 6.67 0 3.98-2.51 7.18-6 7.18-1.17 0-2.27-.61-2.65-1.33l-.72 2.75c-.26 1-.97 2.25-1.45 3.01C9.65 21.84 10.8 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"></path></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle></svg>
                  {%- endcase -%}
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Activewear Quote Block (Column 4) -->
      <div class="m-footer-bs__col m-footer-bs__quote">
        {%- if section.settings.quote_text != blank -%}
          <h4 class="m-footer-bs__quote-title">{{ section.settings.quote_text | newline_to_br }}</h4>
          <span class="m-footer-bs__line"></span>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer Banner & Socials",
  "class": "footer-banner-socials-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1C1B1A"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / Line Color",
      "default": "#EAE6DF"
    },
    {
      "type": "header",
      "content": "Banner Settings (Columns 1 & 2)"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "textarea",
      "id": "banner_heading",
      "label": "Banner Overlay Text",
      "default": "Stronger\ndays ahead"
    },
    {
      "type": "header",
      "content": "Social Links Settings (Column 3)"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social Heading",
      "default": "Follow along"
    },
    {
      "type": "text",
      "id": "social_desc",
      "label": "Social Description",
      "default": "Inspiration. Movement. Real life."
    },
    {
      "type": "header",
      "content": "Quote Settings (Column 4)"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote Text",
      "default": "Activewear\nfor a brighter\ntomorrow."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social Icon Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Platform Title",
          "default": "Instagram"
        },
        {
          "type": "select",
          "id": "platform",
          "label": "Preset Platform Icon",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "custom", "label": "Custom Icon" }
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL",
          "default": "/"
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "Custom SVG Code",
          "info": "Optional: override icon with custom inline SVG"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon Image",
          "info": "Optional: override icon with custom PNG/SVG image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Banner & Socials",
      "blocks": [
        {
          "type": "social_link",
          "settings": {
            "title": "Instagram",
            "platform": "instagram",
            "url": "https://instagram.com"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "title": "Facebook",
            "platform": "facebook",
            "url": "https://facebook.com"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "title": "TikTok",
            "platform": "tiktok",
            "url": "https://tiktok.com"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "title": "YouTube",
            "platform": "youtube",
            "url": "https://youtube.com"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "title": "Pinterest",
            "platform": "pinterest",
            "url": "https://pinterest.com"
          }
        }
      ]
    }
  ]
}
{% endschema %}
