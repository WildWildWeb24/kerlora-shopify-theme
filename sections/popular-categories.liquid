<section class="pc-section" id="pc-section-{{ section.id }}">
  <div class="pc-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="pc-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="pc-grid">
      {% for block in section.blocks %}
        {% assign selected_collection = block.settings.collection %}

        {% if selected_collection != blank %}
          <a
            href="{{ selected_collection.url }}"
            class="pc-card"
            {{ block.shopify_attributes }}
          >
            <div class="pc-image-wrap">
              {% if block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 900 }}"
                  alt="{{ block.settings.custom_title | default: selected_collection.title | escape }}"
                  width="{{ block.settings.custom_image.width }}"
                  height="{{ block.settings.custom_image.height }}"
                  loading="lazy"
                >
              {% elsif selected_collection.image != blank %}
                <img
                  src="{{ selected_collection.image | image_url: width: 900 }}"
                  alt="{{ selected_collection.title | escape }}"
                  width="{{ selected_collection.image.width }}"
                  height="{{ selected_collection.image.height }}"
                  loading="lazy"
                >
              {% endif %}
            </div>

            <h3 class="pc-title">
              {{ block.settings.custom_title | default: selected_collection.title }}
            </h3>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #pc-section-{{ section.id }} {
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #pc-section-{{ section.id }} .pc-wrap {
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  #pc-section-{{ section.id }} .pc-heading {
    margin: 0 0 {{ section.settings.heading_bottom_gap }}px;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: {{ section.settings.heading_color }};
  }

  #pc-section-{{ section.id }} .pc-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.image_gap }}px;
  }

  #pc-section-{{ section.id }} .pc-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #pc-section-{{ section.id }} .pc-image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f2f2f2;
  }

  #pc-section-{{ section.id }} .pc-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ section.settings.image_ratio }};
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  {% if section.settings.enable_hover_zoom %}
    #pc-section-{{ section.id }} .pc-card:hover .pc-image-wrap img {
      transform: scale(1.04);
    }
  {% endif %}

  #pc-section-{{ section.id }} .pc-title {
    margin: {{ section.settings.title_top_gap }}px 0 0;
    text-align: center;
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.2;
    font-weight: 400;
    color: {{ section.settings.title_color }};
  }

  @media screen and (max-width: 749px) {
    #pc-section-{{ section.id }} .pc-wrap {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    #pc-section-{{ section.id }} .pc-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #pc-section-{{ section.id }} .pc-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ section.settings.mobile_gap }}px;
    }

    #pc-section-{{ section.id }} .pc-title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }
  }
</style>

