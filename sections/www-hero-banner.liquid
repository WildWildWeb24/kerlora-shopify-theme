{% comment %}
WWW Hero Banner
Updated version
{% endcomment %}

<section id="www-hero-{{ section.id }}" class="www-hero">

  {% if section.settings.banner_link != blank %}
    <a class="www-hero__banner-link" href="{{ section.settings.banner_link }}" aria-label="{{ section.settings.heading | escape }}"></a>
  {% endif %}

  <picture>
    {% if section.settings.mobile_image != blank %}
      <source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
    {% endif %}

    {% if section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2400
        | image_tag:
          fetchpriority: 'high',
          widths: '800,1200,1600,2000,2400',
          class: 'www-hero__image'
      }}
    {% endif %}
  </picture>

  <div class="www-hero__overlay"></div>

  <div class="www-hero__content">

    {% if section.settings.heading != blank %}
      <h1 class="www-hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="www-hero__button" href="{{ section.settings.button_link | default: section.settings.banner_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}

  </div>

</section>

<style>
#www-hero-{{ section.id }}{
position:relative;
overflow:hidden;
height:{{ section.settings.desktop_height }}px;
}

#www-hero-{{ section.id }} .www-hero__banner-link{
position:absolute;
inset:0;
z-index:1;
}

#www-hero-{{ section.id }} .www-hero__image{
width:100%;
height:100%;
display:block;
object-fit:cover;
}

#www-hero-{{ section.id }} .www-hero__overlay{
position:absolute;
inset:0;
background:{{ section.settings.overlay }};
opacity:{{ section.settings.overlay_opacity | divided_by:100.0 }};
}

#www-hero-{{ section.id }} .www-hero__content{
position:absolute;
left:0;
right:0;
bottom:{{ section.settings.desktop_bottom_padding }}px;
padding-left:{{ section.settings.desktop_side_padding }}px;
padding-right:{{ section.settings.desktop_side_padding }}px;
z-index:3;
max-width:620px;
display:flex;
flex-direction:column;
align-items:flex-start;
}

#www-hero-{{ section.id }} .www-hero__heading{
margin:0 0 24px;
font-size:{{ section.settings.heading_size }}px;
line-height:{{ section.settings.heading_line_height | divided_by: 10.0 }};
letter-spacing:{{ section.settings.heading_letter_spacing }}px;
font-weight:400;
color:{{ section.settings.heading_color }};
}

#www-hero-{{ section.id }} .www-hero__button{
display:inline-flex;
align-items:center;
justify-content:center;
padding:14px 28px;
min-width:220px;
font-size:16px;
background:{{ section.settings.button_bg }};
color:{{ section.settings.button_color }};
text-decoration:none;
}

@media(max-width:749px){

#www-hero-{{ section.id }}{
height:{{ section.settings.mobile_height }}px;
}

#www-hero-{{ section.id }} .www-hero__content{
left:0;
right:0;
bottom:{{ section.settings.mobile_bottom_padding }}px;
padding-left:{{ section.settings.mobile_side_padding }}px;
padding-right:{{ section.settings.mobile_side_padding }}px;
max-width:none;
}

#www-hero-{{ section.id }} .www-hero__heading{
font-size:{{ section.settings.mobile_heading_size }}px;
line-height:{{ section.settings.mobile_heading_line_height | divided_by: 10.0 }};
letter-spacing:{{ section.settings.mobile_heading_letter_spacing }}px;
text-align:left;
}

#www-hero-{{ section.id }} .www-hero__button{
min-width:210px;
padding:12px 24px;
}

}
</style>

{% schema %}
{
"name":"WWW Hero Banner",
"settings":[
{"type":"image_picker","id":"desktop_image","label":"Desktop image"},
{"type":"image_picker","id":"mobile_image","label":"Mobile image"},
{"type":"text","id":"heading","label":"Heading","default":"Designed for the body you have today."},
{"type":"text","id":"button_label","label":"Button","default":"Shop the collection"},
{"type":"url","id":"button_link","label":"Button link"},
{"type":"url","id":"banner_link","label":"Whole banner link"},

{"type":"range","id":"desktop_height","min":500,"max":1000,"step":10,"default":720,"label":"Desktop height"},
{"type":"range","id":"mobile_height","min":500,"max":1200,"step":10,"default":900,"label":"Mobile height"},

{"type":"range","id":"desktop_side_padding","min":0,"max":200,"step":4,"default":80,"unit":"px","label":"Desktop side padding"},
{"type":"range","id":"mobile_side_padding","min":0,"max":80,"step":2,"default":24,"unit":"px","label":"Mobile side padding"},

{"type":"range","id":"desktop_bottom_padding","min":0,"max":200,"step":4,"default":60,"unit":"px","label":"Desktop bottom padding"},
{"type":"range","id":"mobile_bottom_padding","min":0,"max":200,"step":2,"default":40,"unit":"px","label":"Mobile bottom padding"},

{"type":"range","id":"heading_size","min":30,"max":100,"step":2,"default":74,"label":"Desktop heading size"},
{"type":"range","id":"mobile_heading_size","min":24,"max":80,"step":2,"default":56,"label":"Mobile heading size"},

{"type":"range","id":"heading_letter_spacing","min":-2,"max":10,"step":1,"default":0,"unit":"px","label":"Desktop letter spacing"},
{"type":"range","id":"mobile_heading_letter_spacing","min":-2,"max":10,"step":1,"default":0,"unit":"px","label":"Mobile letter spacing"},

{"type":"range","id":"heading_line_height","min":10,"max":20,"step":1,"default":11,"label":"Desktop line height (÷10)"},
{"type":"range","id":"mobile_heading_line_height","min":10,"max":20,"step":1,"default":11,"label":"Mobile line height (÷10)"},

{"type":"color","id":"heading_color","default":"#ffffff","label":"Heading colour"},
{"type":"color","id":"button_bg","default":"#ffffff","label":"Button background"},
{"type":"color","id":"button_color","default":"#222222","label":"Button text"},
{"type":"color","id":"overlay","default":"#000000","label":"Overlay"},
{"type":"range","id":"overlay_opacity","min":0,"max":100,"step":5,"default":0,"label":"Overlay opacity"}
],
"presets":[{"name":"WWW Hero Banner"}]
}
{% endschema %}
