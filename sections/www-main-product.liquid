<script>
  (() => {
    const section = document.getElementById('www-product-{{ section.id }}');
    if (!section || section.dataset.initialised === 'true') return;
    section.dataset.initialised = 'true';

    const form = section.querySelector('[data-product-form]');
    const variantInput = section.querySelector('[data-variant-id]');
    const variantDataElement = section.querySelector('[data-product-variants]');
    const moneyFormatElement = section.querySelector('[data-money-format]');
    const addButton = section.querySelector('[data-add-to-cart]');
    const addButtonText = section.querySelector('[data-add-to-cart-text]');
    const mobileAddButton = section.querySelector('[data-mobile-add]');
    const priceElements = section.querySelectorAll('[data-product-price]');
    const mobilePriceElement = section.querySelector('[data-mobile-price]');
    const comparePriceElements = section.querySelectorAll('[data-compare-price]');
    const optionButtons = Array.from(section.querySelectorAll('[data-option-button]'));
    const variants = variantDataElement ? JSON.parse(variantDataElement.textContent) : [];
    const moneyFormat = moneyFormatElement ? JSON.parse(moneyFormatElement.textContent) : '£{{amount}}';
    const selectedOptions = [];
    const sizeFieldset = section.querySelector('[data-size-option-fieldset]');
    const sizeSelectionMessage = section.querySelector('[data-size-selection-message]');
    const mobileAddText = mobileAddButton?.dataset.mobileAddText || '{{ section.settings.mobile_add_text | escape }}';
    const mobileSelectSizeText = mobileAddButton?.dataset.mobileSelectSizeText || '{{ section.settings.mobile_select_size_text | escape }}';
    let sizeWasSelected = !sizeFieldset;

    const sizeOptionRows = Array.from(
  section.querySelectorAll('[data-size-options]')
);

function updateSizeRows() {
  sizeOptionRows.forEach((row) => {
    const sizeButtons = row.querySelectorAll('.www-product__size');

    row.classList.toggle(
      'is-scrollable',
      sizeButtons.length > 8
    );
  });
}

    section.querySelectorAll('[data-option-index]').forEach((fieldset) => {
      const index = Number(fieldset.dataset.optionIndex);
      const checked = fieldset.querySelector('input:checked');
      if (checked) selectedOptions[index] = checked.value;
    });

    function formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') return window.Shopify.formatMoney(cents, moneyFormat);
      return new Intl.NumberFormat('{{ localization.language.iso_code | default: "en-GB" }}', { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' }).format(Number(cents || 0) / 100);
    }
    function findVariant() { return variants.find((variant) => variant.options.every((option, index) => option === selectedOptions[index])); }
    function optionAvailable(optionIndex, optionValue) {
      const proposed = [...selectedOptions]; proposed[optionIndex] = optionValue;
      return variants.some((variant) => variant.available && variant.options.every((option, index) => option === proposed[index]));
    }
    function updateOptionAvailability() {
      optionButtons.forEach((button) => {
        const available = optionAvailable(Number(button.dataset.optionIndex), button.dataset.optionValue);
        button.classList.toggle('is-unavailable', !available);
      });
    }
    function updateSelectedStyles() {
      optionButtons.forEach((button) => button.classList.toggle('is-selected', selectedOptions[Number(button.dataset.optionIndex)] === button.dataset.optionValue));
      section.querySelectorAll('[data-selected-option]').forEach((label) => { label.textContent = selectedOptions[Number(label.dataset.selectedOption)] || ''; });
    }
    function updateVariant(variant) {
      if (!variant) {
        if (variantInput) variantInput.value = '';
        if (addButton) addButton.disabled = true;
        if (mobileAddButton) mobileAddButton.disabled = true;
        return;
      }
      if (variantInput) variantInput.value = variant.id;
      priceElements.forEach((el) => { el.textContent = formatMoney(variant.price); });
      if (mobilePriceElement) mobilePriceElement.textContent = formatMoney(variant.price);
      comparePriceElements.forEach((el) => {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) { el.hidden = false; el.textContent = formatMoney(variant.compare_at_price); }
        else { el.hidden = true; el.textContent = ''; }
      });
      if (addButton) addButton.disabled = !variant.available;
      if (mobileAddButton) mobileAddButton.disabled = !variant.available;
      const label = variant.available
        ? (sizeWasSelected || !sizeFieldset ? mobileAddText : mobileSelectSizeText)
        : '{{ section.settings.mobile_sold_out_text | escape }}';
      if (mobileAddButton) mobileAddButton.textContent = label;
      if (addButtonText && !variant.available) addButtonText.textContent = '{{ section.settings.mobile_sold_out_text | escape }}';
      const url = new URL(window.location.href); url.searchParams.set('variant', variant.id); window.history.replaceState({}, '', url.toString());
      document.dispatchEvent(new CustomEvent('www:variant:change', { detail: { variant, sectionId: '{{ section.id }}' } }));
    }

    function clearSizeSelectionPrompt() {
      if (sizeSelectionMessage) sizeSelectionMessage.hidden = true;
      if (sizeFieldset) sizeFieldset.classList.remove('needs-selection');
      if (mobileAddButton && !mobileAddButton.disabled) mobileAddButton.textContent = mobileAddText;
    }

    function promptForSizeSelection() {
      if (!sizeFieldset) return false;
      if (sizeSelectionMessage) sizeSelectionMessage.hidden = false;
      sizeFieldset.classList.add('needs-selection');
      sizeFieldset.scrollIntoView({ behavior: 'smooth', block: 'center' });
      window.setTimeout(() => {
        const firstSizeInput = sizeFieldset.querySelector('input[type="radio"]');
        if (firstSizeInput) firstSizeInput.focus({ preventScroll: true });
      }, 500);
      return true;
    }

    optionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.classList.contains('is-unavailable')) return;
        const optionIndex = Number(button.dataset.optionIndex);
        if (sizeFieldset && sizeFieldset.contains(button)) {
          sizeWasSelected = true;
          clearSizeSelectionPrompt();
        }
        selectedOptions[optionIndex] = button.dataset.optionValue;
        const input = button.querySelector('input'); if (input) input.checked = true;
        updateSizeRows();
updateSelectedStyles();
updateOptionAvailability();
updateVariant(findVariant());
      });
    });

    if (mobileAddButton && addButton) {
      mobileAddButton.addEventListener('click', () => {
        if (mobileAddButton.disabled) return;
        if (!sizeWasSelected && sizeFieldset) {
          promptForSizeSelection();
          return;
        }
        addButton.click();
      });
    }
    if (form && addButton) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!sizeWasSelected && sizeFieldset) {
          promptForSizeSelection();
          return;
        }
        addButton.classList.add('is-loading');
        addButton.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            items: [{ id: variantInput.value, quantity: 1 }],
            sections: 'cart-drawer',
            sections_url: window.location.pathname
          })
        })
        .then((res) => (res.ok ? res.json() : Promise.reject(res)))
        .then((e) => {
          const drawer = document.querySelector('m-cart-drawer');
          if (drawer) {
            drawer.renderContents(e);
          }
        })
        .catch(() => form.submit())
        .finally(() => {
          addButton.classList.remove('is-loading');
          const variant = findVariant();
          addButton.disabled = !variant || !variant.available;
        });
      });
    }

    const wishlistButton = section.querySelector('[data-wishlist-button]');
    if (wishlistButton) {
      const storageKey = 'kerlora_wishlist'; const handle = wishlistButton.dataset.productHandle;
      const read = () => { try { return JSON.parse(localStorage.getItem(storageKey)) || []; } catch (e) { return []; } };
      const sync = () => { const active = read().includes(handle); wishlistButton.classList.toggle('is-active', active); wishlistButton.setAttribute('aria-pressed', active ? 'true' : 'false'); };
      wishlistButton.addEventListener('click', () => { let list = read(); list = list.includes(handle) ? list.filter((item) => item !== handle) : [...list, handle]; localStorage.setItem(storageKey, JSON.stringify(list)); sync(); });
      sync();
    }

    const drawer = section.querySelector('[data-size-guide-drawer]');
    const drawerOpen = section.querySelector('[data-size-guide-open]');
    const drawerCloseButtons = section.querySelectorAll('[data-size-guide-close]');
    const openDrawer = () => { if (!drawer) return; drawer.classList.add('is-open'); drawer.setAttribute('aria-hidden', 'false'); document.documentElement.style.overflow = 'hidden'; };
    const closeDrawer = () => { if (!drawer) return; drawer.classList.remove('is-open'); drawer.setAttribute('aria-hidden', 'true'); document.documentElement.style.overflow = ''; };
    if (drawerOpen) drawerOpen.addEventListener('click', openDrawer);
    drawerCloseButtons.forEach((button) => button.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDrawer(); });

    const gallery = section.querySelector('[data-gallery]');
    const galleryItems = Array.from(section.querySelectorAll('[data-gallery-item]'));
    const dots = Array.from(section.querySelectorAll('[data-gallery-dot]'));
    const currentCount = section.querySelector('[data-gallery-current]');
    let galleryTimer = null;
    function setGalleryIndex(index) {
      dots.forEach((dot, i) => { dot.classList.toggle('is-active', i === index); dot.setAttribute('aria-current', i === index ? 'true' : 'false'); });
      if (currentCount) currentCount.textContent = String(index + 1);
    }
    if (gallery && galleryItems.length > 1) {
      gallery.addEventListener('scroll', () => {
        clearTimeout(galleryTimer);
        galleryTimer = setTimeout(() => {
          const index = Math.round(gallery.scrollLeft / gallery.clientWidth);
          setGalleryIndex(Math.max(0, Math.min(index, galleryItems.length - 1)));
        }, 60);
      }, { passive: true });
      dots.forEach((dot) => dot.addEventListener('click', () => gallery.scrollTo({ left: gallery.clientWidth * Number(dot.dataset.galleryDot), behavior: 'smooth' })));
    }


    const lightbox = section.querySelector('[data-product-lightbox]');
    if (lightbox) {
      const openButtons = Array.from(section.querySelectorAll('[data-lightbox-open]'));
      const closeButton = lightbox.querySelector('[data-lightbox-close]');
      const previousButton = lightbox.querySelector('[data-lightbox-previous]');
      const nextButton = lightbox.querySelector('[data-lightbox-next]');
      const slides = Array.from(lightbox.querySelectorAll('[data-lightbox-slide]'));
      const thumbs = Array.from(lightbox.querySelectorAll('[data-lightbox-thumbnail]'));
      const current = lightbox.querySelector('[data-lightbox-current]');
      const stage = lightbox.querySelector('[data-lightbox-stage]');
      let index = 0, lastFocused = null, touchStartX = 0, touchStartY = 0, lastTap = 0;

      const pauseMedia = (activeIndex) => {
        slides.forEach((slide, i) => {
          if (i !== activeIndex) slide.querySelectorAll('video').forEach((video) => video.pause());
          if (i !== activeIndex) slide.querySelectorAll('[data-lightbox-image-wrap]').forEach((wrap) => wrap.classList.remove('is-zoomed'));
        });
      };
      const showSlide = (requested) => {
        if (!slides.length) return;
        index = (requested + slides.length) % slides.length;
        slides.forEach((slide, i) => { const active = i === index; slide.classList.toggle('is-active', active); slide.setAttribute('aria-hidden', active ? 'false' : 'true'); });
        thumbs.forEach((thumb, i) => { const active = i === index; thumb.classList.toggle('is-active', active); thumb.setAttribute('aria-current', active ? 'true' : 'false'); if (active) thumb.scrollIntoView({ block:'nearest', inline:'nearest', behavior:'smooth' }); });
        if (current) current.textContent = String(index + 1);
        pauseMedia(index);
      };
      const openLightbox = (requested) => { lastFocused = document.activeElement; showSlide(requested); lightbox.classList.add('is-open'); lightbox.setAttribute('aria-hidden','false'); document.documentElement.classList.add('www-product-lightbox-open'); requestAnimationFrame(() => closeButton && closeButton.focus()); };
      const closeLightbox = () => { lightbox.classList.remove('is-open'); lightbox.setAttribute('aria-hidden','true'); document.documentElement.classList.remove('www-product-lightbox-open'); slides.forEach((slide) => slide.querySelectorAll('video').forEach((video) => video.pause())); if (lastFocused && lastFocused.focus) lastFocused.focus(); };
      const nextSlide = () => showSlide(index + 1);
      const previousSlide = () => showSlide(index - 1);

      openButtons.forEach((button) => button.addEventListener('click', () => openLightbox(Number(button.dataset.lightboxOpen))));
      thumbs.forEach((thumb) => thumb.addEventListener('click', () => showSlide(Number(thumb.dataset.lightboxThumbnail))));
      closeButton && closeButton.addEventListener('click', closeLightbox);
      previousButton && previousButton.addEventListener('click', previousSlide);
      nextButton && nextButton.addEventListener('click', nextSlide);

      stage && stage.addEventListener('touchstart', (event) => { if (event.touches.length === 1) { touchStartX = event.touches[0].clientX; touchStartY = event.touches[0].clientY; } }, { passive:true });
      stage && stage.addEventListener('touchend', (event) => { if (event.changedTouches.length !== 1) return; const dx = event.changedTouches[0].clientX - touchStartX; const dy = event.changedTouches[0].clientY - touchStartY; if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.25) dx < 0 ? nextSlide() : previousSlide(); }, { passive:true });
      lightbox.querySelectorAll('[data-lightbox-image-wrap]').forEach((wrap) => { wrap.addEventListener('dblclick', () => wrap.classList.toggle('is-zoomed')); wrap.addEventListener('touchend', () => { const now = Date.now(); if (now - lastTap < 320) wrap.classList.toggle('is-zoomed'); lastTap = now; }, { passive:true }); });

      document.addEventListener('keydown', (event) => {
        if (!lightbox.classList.contains('is-open')) return;
        if (event.key === 'Escape') { event.preventDefault(); closeLightbox(); }
        if (event.key === 'ArrowRight') { event.preventDefault(); nextSlide(); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); previousSlide(); }
      });
    }

    const questionModal = section.querySelector('[data-question-modal]');
    const questionOpenButtons = Array.from(section.querySelectorAll('[data-question-open]'));
    const questionCloseButtons = questionModal ? Array.from(questionModal.querySelectorAll('[data-question-close]')) : [];
    let questionLastFocused = null;

    function openQuestionModal() {
      if (!questionModal) return;
      questionLastFocused = document.activeElement;
      questionModal.classList.add('is-open');
      questionModal.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('www-product-question-open');
      const firstInput = questionModal.querySelector('input:not([type="hidden"])');
      requestAnimationFrame(() => firstInput?.focus());
    }

    function closeQuestionModal() {
      if (!questionModal) return;
      questionModal.classList.remove('is-open');
      questionModal.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('www-product-question-open');
      if (questionLastFocused && typeof questionLastFocused.focus === 'function') questionLastFocused.focus();
    }

    questionOpenButtons.forEach((button) => button.addEventListener('click', openQuestionModal));
    questionCloseButtons.forEach((button) => button.addEventListener('click', closeQuestionModal));

    const shareButtons = Array.from(section.querySelectorAll('[data-product-share]'));

    async function copyProductLink(button) {
      const shareLabel = button.querySelector('[data-share-label]');
      const originalLabel = shareLabel?.textContent || 'Share';
      try {
        await navigator.clipboard.writeText(window.location.href);
      } catch (error) {
        const temporaryInput = document.createElement('input');
        temporaryInput.value = window.location.href;
        document.body.appendChild(temporaryInput);
        temporaryInput.select();
        document.execCommand('copy');
        temporaryInput.remove();
      }
      if (shareLabel) {
        shareLabel.textContent = 'Link copied';
        window.setTimeout(() => { shareLabel.textContent = originalLabel; }, 1800);
      }
    }

    shareButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const shareData = { title: button.dataset.shareTitle || document.title, text: button.dataset.shareText || document.title, url: window.location.href };
        if (navigator.share) {
          try { await navigator.share(shareData); return; }
          catch (error) { if (error?.name === 'AbortError') return; }
        }
        await copyProductLink(button);
      });
    });

    function addBusinessDays(startDate, numberOfDays) {
      const result = new Date(startDate);
      let added = 0;
      while (added < numberOfDays) {
        result.setDate(result.getDate() + 1);
        const day = result.getDay();
        if (day !== 0 && day !== 6) added += 1;
      }
      return result;
    }

    function addCalendarDays(startDate, numberOfDays) {
      const result = new Date(startDate);
      result.setDate(result.getDate() + numberOfDays);
      return result;
    }

    function formatDeliveryDate(date, locale) {
      return new Intl.DateTimeFormat(locale || 'en-GB', { day: '2-digit', month: 'short' }).format(date);
    }

    section.querySelectorAll('[data-uk-delivery]').forEach((deliveryElement) => {
      const minDays = Number(deliveryElement.dataset.minDays || 2);
      const maxDays = Number(deliveryElement.dataset.maxDays || 5);
      const useBusinessDays = deliveryElement.dataset.businessDays === 'true';
      const locale = deliveryElement.dataset.dateLocale || 'en-GB';
      const today = new Date();
      const startDate = useBusinessDays ? addBusinessDays(today, minDays) : addCalendarDays(today, minDays);
      const endDate = useBusinessDays ? addBusinessDays(today, maxDays) : addCalendarDays(today, maxDays);
      const target = deliveryElement.querySelector('[data-delivery-range]');
      if (target) target.textContent = `${formatDeliveryDate(startDate, locale)} – ${formatDeliveryDate(endDate, locale)}`;
    });

    async function updateFreeShippingProgress() {
      const rows = Array.from(section.querySelectorAll('[data-free-shipping-row]'));
      for (const row of rows) {
        const textElement = row.querySelector('[data-free-shipping-text]');
        if (!textElement) continue;
        const progressEnabled = row.dataset.progressEnabled === 'true';
        const defaultText = row.dataset.defaultText || '';
        if (!progressEnabled) { textElement.textContent = defaultText; continue; }
        try {
          const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error('Unable to load cart.');
          const cart = await response.json();
          const threshold = Number(row.dataset.thresholdPence || 0);
          const remaining = Math.max(0, threshold - Number(cart.total_price || 0));
          if (remaining <= 0) textElement.textContent = row.dataset.reachedText || 'You qualify for free shipping.';
          else textElement.textContent = (row.dataset.belowText || 'You are [amount] away from free shipping.').replace('[amount]', formatMoney(remaining));
        } catch (error) { textElement.textContent = defaultText; }
      }
    }

    updateFreeShippingProgress();
    document.addEventListener('cart:updated', updateFreeShippingProgress);
    document.addEventListener('ajaxProduct:added', updateFreeShippingProgress);

    const questionVariantInput = section.querySelector('[data-question-variant]');
    document.addEventListener('www:variant:change', (event) => {
      if (!questionVariantInput || event.detail?.sectionId !== '{{ section.id }}' || !event.detail?.variant) return;
      questionVariantInput.value = event.detail.variant.title || '';
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && questionModal?.classList.contains('is-open')) closeQuestionModal();
    });

    const productPanel = section.querySelector('.www-product__panel');
    const productPanelInner = section.querySelector('.www-product__panel-inner');
    const desktopStickyOffset = {{ section.settings.desktop_sticky_offset | default: 0 }};

    function getHeaderHeight() {
      const cssHeaderHeight = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--m-header-height')
      );

      if (Number.isFinite(cssHeaderHeight) && cssHeaderHeight > 0) {
        return cssHeaderHeight;
      }

      const header =
        document.querySelector('sticky-header') ||
        document.querySelector('.m-header') ||
        document.querySelector('header');

      if (!header) return 0;

      const headerStyles = getComputedStyle(header);
      const headerIsFixed =
        headerStyles.position === 'fixed' ||
        headerStyles.position === 'sticky';

      return headerIsFixed ? header.getBoundingClientRect().height : 0;
    }

    function resetDesktopStickyPanel() {
      if (!productPanelInner) return;

      productPanelInner.classList.remove('is-fixed', 'is-bottom');
      productPanelInner.style.removeProperty('--www-sticky-top');
      productPanelInner.style.removeProperty('--www-sticky-left');
      productPanelInner.style.removeProperty('--www-sticky-width');

      if (productPanel) {
        productPanel.style.removeProperty('min-height');
      }
    }

    function updateDesktopStickyPanel() {
      if (!productPanel || !productPanelInner) return;

      if (!window.matchMedia('(min-width: 990px)').matches) {
        resetDesktopStickyPanel();
        return;
      }

      const sectionRect = section.getBoundingClientRect();
      const panelRect = productPanel.getBoundingClientRect();
      const innerHeight = productPanelInner.offsetHeight;
      const stickyTop = getHeaderHeight() + desktopStickyOffset;
      const availableSectionHeight = section.offsetHeight;

      productPanel.style.minHeight = `${Math.min(innerHeight, availableSectionHeight)}px`;

      const shouldFix =
        sectionRect.top <= stickyTop &&
        sectionRect.bottom > stickyTop + innerHeight;

      const shouldStopAtBottom =
        sectionRect.top <= stickyTop &&
        sectionRect.bottom <= stickyTop + innerHeight;

      if (shouldFix) {
        productPanelInner.classList.add('is-fixed');
        productPanelInner.classList.remove('is-bottom');
        productPanelInner.style.setProperty('--www-sticky-top', `${stickyTop}px`);
        productPanelInner.style.setProperty('--www-sticky-left', `${panelRect.left}px`);
        productPanelInner.style.setProperty('--www-sticky-width', `${panelRect.width}px`);
      } else if (shouldStopAtBottom) {
        productPanelInner.classList.remove('is-fixed');
        productPanelInner.classList.add('is-bottom');
        productPanelInner.style.removeProperty('--www-sticky-top');
        productPanelInner.style.removeProperty('--www-sticky-left');
        productPanelInner.style.removeProperty('--www-sticky-width');
      } else {
        resetDesktopStickyPanel();
      }
    }

    let stickyFrame = null;
    function requestStickyUpdate() {
      if (stickyFrame) cancelAnimationFrame(stickyFrame);
      stickyFrame = requestAnimationFrame(() => {
        updateDesktopStickyPanel();
        stickyFrame = null;
      });
    }

    window.addEventListener('scroll', requestStickyUpdate, { passive: true });
    window.addEventListener('resize', requestStickyUpdate);

    if ('ResizeObserver' in window && productPanelInner) {
      const stickyResizeObserver = new ResizeObserver(requestStickyUpdate);
      stickyResizeObserver.observe(productPanelInner);
      stickyResizeObserver.observe(section);
    }

    requestStickyUpdate();

    updateSizeRows(); updateSelectedStyles(); updateOptionAvailability(); updateVariant(findVariant());
  })();
</script>

