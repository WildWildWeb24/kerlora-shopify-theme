{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'WWWProductForm-' | append: section.id
  assign media_count = product.media.size

  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank and product.collections.size > 0
    assign breadcrumb_collection = product.collections.first
  endif
%}

<section
  id="www-product-{{ section.id }}"
  class="www-product"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
>
  <div class="www-product__layout">
    <div class="www-product__gallery-wrap">
      <div class="www-product__gallery" data-gallery>
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <div
              class="www-product__media"
              data-gallery-item
              data-media-id="{{ media.id }}"
              data-media-index="{{ forloop.index0 }}"
            >
              {% case media.media_type %}
                {% when 'image' %}
                  {{
                    media.preview_image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'www-product__image',
                      widths: '500, 750, 1000, 1250, 1500, 1800',
                      sizes: '(min-width: 990px) 34vw, 100vw',
                      loading: 'lazy',
                      alt: media.alt
                  }}

                {% when 'video' %}
                  {{
                    media
                    | video_tag:
                      class: 'www-product__video',
                      controls: true,
                      muted: true,
                      playsinline: true,
                      preload: 'metadata',
                      image_size: '1200x'
                  }}

                {% when 'external_video' %}
                  {{ media | external_video_tag: class: 'www-product__external-video' }}

                {% when 'model' %}
                  {{
                    media
                    | model_viewer_tag:
                      class: 'www-product__model',
                      reveal: 'interaction',
                      toggleable: true
                  }}
              {% endcase %}

              {% if section.settings.enable_gallery_lightbox %}
                <button type="button" class="www-product__zoom-trigger" data-lightbox-open="{{ forloop.index0 }}" aria-label="Open {{ product.title | escape }} media {{ forloop.index }} in fullscreen gallery">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"></path></svg>
                </button>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <div class="www-product__media" data-gallery-item>
            {{ 'product-1' | placeholder_svg_tag: 'www-product__placeholder' }}
          </div>
        {% endif %}
      </div>

      {% if media_count > 1 %}
        <div
          class="www-product__pagination www-product__pagination--{{ section.settings.mobile_pagination_style }}"
          data-gallery-pagination
          aria-label="Product gallery pagination"
        >
          {% if section.settings.mobile_pagination_style == 'dots' or section.settings.mobile_pagination_style == 'both' %}
            <div class="www-product__pagination-dots">
              {% for media in product.media %}
                <button
                  type="button"
                  class="www-product__pagination-dot{% if forloop.first %} is-active{% endif %}"
                  data-gallery-dot="{{ forloop.index0 }}"
                  aria-label="Go to image {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></button>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.mobile_pagination_style == 'count' or section.settings.mobile_pagination_style == 'both' %}
            <div class="www-product__pagination-count">
              <span data-gallery-current>1</span>
              <span>/</span>
              <span>{{ media_count }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.enable_gallery_lightbox and media_count > 0 %}
      <div class="www-product__lightbox" data-product-lightbox aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ product.title | escape }} media gallery">
        <div class="www-product__lightbox-shell">
          <div class="www-product__lightbox-topbar">
            <div class="www-product__lightbox-count" aria-live="polite"><span data-lightbox-current>1</span><span aria-hidden="true"> / </span><span>{{ media_count }}</span></div>
            <button type="button" class="www-product__lightbox-close" data-lightbox-close aria-label="Close fullscreen gallery">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg>
            </button>
          </div>
          <div class="www-product__lightbox-body">
            {% if section.settings.show_lightbox_thumbnails and media_count > 1 %}
              <div class="www-product__lightbox-thumbnails" data-lightbox-thumbnails aria-label="Gallery thumbnails">
                {% for media in product.media %}
                  <button type="button" class="www-product__lightbox-thumbnail{% if forloop.first %} is-active{% endif %}" data-lightbox-thumbnail="{{ forloop.index0 }}" aria-label="View media {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    {{ media.preview_image | image_url: width: 180 | image_tag: class: 'www-product__lightbox-thumbnail-image', widths: '90, 120, 180', sizes: '72px', loading: 'lazy', alt: media.alt }}
                    {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                      <span class="www-product__lightbox-thumbnail-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 7l8 5-8 5V7Z"></path></svg></span>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            {% endif %}
            <div class="www-product__lightbox-stage-wrap">
              {% if media_count > 1 %}
                <button type="button" class="www-product__lightbox-arrow www-product__lightbox-arrow--previous" data-lightbox-previous aria-label="Previous media"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg></button>
              {% endif %}
              <div class="www-product__lightbox-stage" data-lightbox-stage>
                {% for media in product.media %}
                  <div class="www-product__lightbox-slide{% if forloop.first %} is-active{% endif %}" data-lightbox-slide="{{ forloop.index0 }}" data-lightbox-media-type="{{ media.media_type }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                    {% case media.media_type %}
                      {% when 'image' %}
                        <div class="www-product__lightbox-image-wrap" data-lightbox-image-wrap>
                          {{ media.preview_image | image_url: width: 3200 | image_tag: class: 'www-product__lightbox-image', widths: '900, 1200, 1600, 2000, 2400, 3200', sizes: '100vw', loading: 'lazy', alt: media.alt }}
                        </div>
                      {% when 'video' %}
                        {{ media | video_tag: class: 'www-product__lightbox-video', controls: true, muted: false, playsinline: true, preload: 'metadata', image_size: '2000x' }}
                      {% when 'external_video' %}
                        <div class="www-product__lightbox-external-wrap">{{ media | external_video_tag: class: 'www-product__lightbox-external-video' }}</div>
                      {% when 'model' %}
                        {{ media | model_viewer_tag: class: 'www-product__lightbox-model', reveal: 'interaction', toggleable: true }}
                    {% endcase %}
                  </div>
                {% endfor %}
              </div>
              {% if media_count > 1 %}
                <button type="button" class="www-product__lightbox-arrow www-product__lightbox-arrow--next" data-lightbox-next aria-label="Next media"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg></button>
              {% endif %}
            </div>
          </div>
          <div class="www-product__lightbox-help">Swipe or use arrow keys to browse <span aria-hidden="true">•</span> Double-click or double-tap images to zoom</div>
        </div>
      </div>
    {% endif %}

    <div class="www-product__panel">
      <div class="www-product__panel-inner">
        {% form 'product',
          product,
          id: product_form_id,
          class: 'www-product__form',
          data-product-form: ''
        %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'breadcrumbs' %}
                <div
                  class="www-product__block www-product__block--breadcrumbs"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <nav class="www-product__breadcrumbs" aria-label="Breadcrumb">
                    {% if block.settings.show_home %}
                      <a href="{{ routes.root_url }}">{{ block.settings.home_label }}</a>
                    {% endif %}

                    {% if breadcrumb_collection != blank %}
                      {% if block.settings.show_home %}
                        <span class="www-product__breadcrumb-separator" aria-hidden="true">/</span>
                      {% endif %}
                      <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
                    {% endif %}

                    {% if block.settings.show_product %}
                      {% if block.settings.show_home or breadcrumb_collection != blank %}
                        <span class="www-product__breadcrumb-separator" aria-hidden="true">/</span>
                      {% endif %}
                      <span class="www-product__breadcrumb-current" aria-current="page">{{ product.title }}</span>
                    {% endif %}
                  </nav>
                </div>

              {% when 'wishlist' %}
                <div
                  class="www-product__block www-product__block--wishlist www-product__align-{{ block.settings.alignment }}"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <button
                    type="button"
                    class="www-product__wishlist"
                    data-wishlist-button
                    data-product-handle="{{ product.handle }}"
                    aria-label="Add {{ product.title | escape }} to favourites"
                    aria-pressed="false"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 21s-7.2-4.4-9.5-9.1C.5 7.8 2.8 4 6.7 4c2 0 3.7 1.1 5.3 3 1.6-1.9 3.3-3 5.3-3 3.9 0 6.2 3.8 4.2 7.9C19.2 16.6 12 21 12 21Z"></path>
                    </svg>
                  </button>
                </div>

              {% when 'title' %}
                <div
                  class="www-product__block"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <h1
                    class="www-product__title www-product__text-{{ block.settings.alignment }}"
                    style="--title-size: {{ block.settings.font_size }}px; --title-size-mobile: {{ block.settings.mobile_font_size }}px; --title-weight: {{ block.settings.font_weight }}; --title-color: {{ block.settings.color }}; --title-line-height: {{ block.settings.line_height | divided_by: 100.0 }};"
                  >
                    {{ product.title }}
                  </h1>
                </div>

              {% when 'price' %}
                <div
                  class="www-product__block www-product__text-{{ block.settings.alignment }}"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <div
                    class="www-product__price"
                    data-product-price
                    style="--price-size: {{ block.settings.font_size }}px; --price-size-mobile: {{ block.settings.mobile_font_size }}px; --price-color: {{ block.settings.color }};"
                  >
                    {{ current_variant.price | money }}
                  </div>
                  <div
                    class="www-product__compare-price"
                    data-compare-price
                    {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
                  >
                    {% if current_variant.compare_at_price > current_variant.price %}
                      {{ current_variant.compare_at_price | money }}
                    {% endif %}
                  </div>
                  {% if block.settings.show_tax_text %}
                    <div class="www-product__tax-text">{{ block.settings.tax_text }}</div>
                  {% endif %}
                </div>

              {% when 'payment_terms' %}
                <div
                  class="www-product__block www-product__payment-terms"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; font-size: {{ block.settings.font_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  {{ form | payment_terms }}
                </div>

              {% when 'colour_products' %}
                {% assign colour_products = product.metafields.custom.custom_colour_products.value %}
                {% assign current_colour_name = product.metafields.custom.colour_name.value | default: product.metafields.custom.colour_name | default: product.title %}

                <div
                  class="www-product__block"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <fieldset class="www-product__colour-products">
                    <legend
                      class="www-product__option-label"
                      style="font-size: {{ block.settings.label_size }}px;"
                    >
                      {{ block.settings.label }}:
                      <span>{{ current_colour_name }}</span>
                    </legend>

                    <div
                      class="www-product__colour-product-list"
                      style="--variant-gap: {{ block.settings.gap }}px; --colour-thumbnail-size: {{ block.settings.thumbnail_size }}px; --colour-thumbnail-radius: {{ block.settings.thumbnail_radius }}px;"
                    >
                      {% assign current_product_image = product.images.first %}
                      {% if current_product_image != blank %}
                        <a
                          href="{{ product.url }}"
                          class="www-product__colour-product is-selected"
                          aria-current="page"
                          aria-label="{{ current_colour_name | escape }} — current colour"
                          title="{{ current_colour_name | escape }}"
                        >
                          {{
                            current_product_image
                            | image_url: width: 240
                            | image_tag:
                              class: 'www-product__colour-product-image',
                              widths: '80, 120, 160, 240',
                              sizes: '80px',
                              loading: 'lazy',
                              alt: current_product_image.alt | default: current_colour_name
                          }}
                        </a>
                      {% endif %}

                      {% if colour_products != blank %}
                        {% for colour_product in colour_products %}
                          {% unless colour_product.id == product.id %}
                            {% assign linked_colour_name = colour_product.metafields.custom.colour_name.value | default: colour_product.metafields.custom.colour_name | default: colour_product.title %}
                            {% assign colour_product_image = colour_product.images.first %}
                            {% if colour_product_image != blank %}
                              <a
                                href="{{ colour_product.url }}"
                                class="www-product__colour-product"
                                aria-label="View {{ linked_colour_name | escape }}"
                                title="{{ linked_colour_name | escape }}"
                              >
                                {{
                                  colour_product_image
                                  | image_url: width: 240
                                  | image_tag:
                                    class: 'www-product__colour-product-image',
                                    widths: '80, 120, 160, 240',
                                    sizes: '80px',
                                    loading: 'lazy',
                                    alt: colour_product_image.alt | default: linked_colour_name
                                }}
                              </a>
                            {% endif %}
                          {% endunless %}
                        {% endfor %}
                      {% endif %}
                    </div>
                  </fieldset>
                </div>

              {% when 'variant_picker' %}
                <div
                  class="www-product__block"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <div class="www-product__variants">
                    <div class="www-product__selection-message" data-size-selection-message role="alert" hidden>
                      {{ block.settings.size_selection_message }}
                    </div>

                    {% for option in product.options_with_values %}
                      {% assign option_index = forloop.index0 %}
                      {% assign option_name_downcase = option.name | downcase %}
                      {% assign selected_value = current_variant.options[option_index] %}
                      {% assign is_colour_option = false %}
{% assign is_size_option = false %}

{% if option_name_downcase contains 'colour' or option_name_downcase contains 'color' %}
  {% assign is_colour_option = true %}
{% endif %}

{% if option_name_downcase contains 'size' %}
  {% assign is_size_option = true %}
{% endif %}

                      <fieldset
                        class="www-product__option{% if is_size_option %} www-product__option--size{% endif %}"
                        data-option-index="{{ option_index }}"
                        {% if is_size_option %}data-size-option-fieldset{% endif %}
                      >
                        <div class="www-product__option-heading">
                          <legend class="www-product__option-label" style="font-size: {{ block.settings.label_size }}px;">
                            {{ option.name }}:
                            <span data-selected-option="{{ option_index }}">{{ selected_value }}</span>
                          </legend>

                          {% if option_name_downcase contains 'size' and block.settings.size_guide_page != blank %}
                            <button
                              type="button"
                              class="www-product__size-guide-trigger"
                              data-size-guide-open
                            >
                              {{ block.settings.size_guide_label }}
                            </button>
                          {% endif %}
                        </div>

                        <div
  class="
    www-product__option-values
    {% if is_colour_option %} www-product__option-values--swatches{% endif %}
    {% if is_size_option %} www-product__option-values--sizes{% endif %}
  "
  style="--variant-gap: {{ block.settings.gap }}px;"
  {% if is_size_option %}data-size-options{% endif %}
>
                          {% for value in option.values %}
                            {% assign value_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index %}
                            <label
                              class="www-product__option-value {% if is_colour_option %}www-product__swatch{% else %}www-product__size{% endif %}{% if value == selected_value %} is-selected{% endif %}"
                              data-option-button
                              data-option-index="{{ option_index }}"
                              data-option-value="{{ value | escape }}"
                              style="--variant-height: {{ block.settings.button_height }}px; --variant-min-width: {{ block.settings.button_min_width }}px; --variant-font-size: {{ block.settings.button_font_size }}px; --variant-radius: {{ block.settings.button_radius }}px; --variant-border: {{ block.settings.border_color }}; --variant-selected-bg: {{ block.settings.selected_background }}; --variant-selected-text: {{ block.settings.selected_text_color }}; --swatch-size: {{ block.settings.swatch_size }}px;"
                            >
                              <input
                                id="{{ value_id }}"
                                class="www-product__option-input"
                                type="radio"
                                name="options[{{ option.name | escape }}]"
                                value="{{ value | escape }}"
                                {% if value == selected_value %}checked{% endif %}
                              >
                              {% if is_colour_option %}
                                <span class="www-product__swatch-circle" style="background-color: {{ value | downcase | replace: ' ', '' }};"></span>
                                <span class="visually-hidden">{{ value }}</span>
                              {% else %}
                                <span>{{ value }}</span>
                              {% endif %}
                            </label>
                          {% endfor %}
                        </div>
                      </fieldset>
                    {% endfor %}
                  </div>
                </div>

              {% when 'description' %}
                <div
                  class="www-product__block www-product__description rte"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; --bullet-line-height: {{ block.settings.bullet_line_height | divided_by: 100.0 }}; --bullet-line-height-mobile: {{ block.settings.mobile_bullet_line_height | divided_by: 100.0 }}; --bullet-gap: {{ block.settings.bullet_gap }}px; --bullet-gap-mobile: {{ block.settings.mobile_bullet_gap }}px; font-size: {{ block.settings.font_size }}px; line-height: {{ block.settings.line_height | divided_by: 100.0 }}; color: {{ block.settings.color }};"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.source == 'features' and product.metafields.custom.product_features != blank %}
                    {% assign features = product.metafields.custom.product_features.value %}
                    {% if features.first %}
                      <ul>
                        {% for feature in features %}<li>{{ feature }}</li>{% endfor %}
                      </ul>
                    {% else %}
                      {{ product.metafields.custom.product_features | metafield_tag }}
                    {% endif %}
                  {% else %}
                    {{ product.description }}
                  {% endif %}
                </div>

              {% when 'custom_text' %}
                <div
                  class="www-product__block rte www-product__text-{{ block.settings.alignment }}"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; font-size: {{ block.settings.font_size }}px; line-height: {{ block.settings.line_height | divided_by: 100.0 }}; color: {{ block.settings.color }};"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.content }}
                </div>

              {% when 'add_to_cart' %}
                <div
                  class="www-product__block"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  <div class="www-product__error" data-product-error role="alert" hidden></div>
                  <button
                    type="submit"
                    name="add"
                    class="www-product__add-button"
                    data-add-to-cart
                    style="--atc-height: {{ block.settings.height }}px; --atc-size: {{ block.settings.font_size }}px; --atc-radius: {{ block.settings.radius }}px; --atc-bg: {{ block.settings.background }}; --atc-text: {{ block.settings.text_color }};"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-to-cart-text>
                      {% if current_variant.available %}{{ block.settings.add_to_cart_text }}{% else %}{{ block.settings.sold_out_text }}{% endif %}
                    </span>
                    <span class="www-product__button-loader" hidden aria-hidden="true"></span>
                  </button>
                </div>

                            {% when 'custom_image' %}
                <div
                  class="www-product__block www-product__block--custom-image www-product__align-{{ block.settings.alignment }}"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; --custom-image-max-width: {{ block.settings.max_width }}px;"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.image != blank %}
                    <div class="www-product__custom-image-wrap">
                      {{
                        block.settings.image
                        | image_url: width: 400
                        | image_tag:
                          class: 'www-product__custom-image',
                          widths: '100, 200, 300, 400',
                          loading: 'lazy',
                          alt: block.settings.image.alt | default: ''
                      }}
                    </div>
                  {% endif %}
                </div>

              {% when 'dynamic_checkout' %}
                <div
                  class="www-product__block www-product__dynamic-checkout"
                  style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  {{ form | payment_button }}
                </div>

              {% when 'payment_methods' %}
                <div class="www-product__block www-product__payment-methods" style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; --payment-icon-height: {{ block.settings.icon_height }}px; --payment-icon-gap: {{ block.settings.icon_gap }}px;" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}<div class="www-product__confidence-heading">{{ block.settings.heading }}</div>{% endif %}
                  <div class="www-product__payment-icons" aria-label="{{ block.settings.heading | default: 'Accepted payment methods' | escape }}">
                    {% for type in shop.enabled_payment_types %}<span class="www-product__payment-icon">{{ type | payment_type_svg_tag }}</span>{% endfor %}
                    {% if block.settings.show_klarna %}{% unless shop.enabled_payment_types contains 'klarna' %}<span class="www-product__payment-icon">{{ 'klarna' | payment_type_svg_tag }}</span>{% endunless %}{% endif %}
                  </div>
                </div>

              {% when 'product_actions' %}
                <div class="www-product__block www-product__product-actions" style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; --action-font-size: {{ block.settings.font_size }}px; --action-icon-size: {{ block.settings.icon_size }}px; --action-gap: {{ block.settings.action_gap }}px;" {{ block.shopify_attributes }}>
                  {% if block.settings.show_ask_question %}
                    <button type="button" class="www-product__action-link" data-question-open aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v11H9l-5 3v-14Z"></path><path d="M8 9h8M8 13h5"></path></svg><span>{{ block.settings.ask_label }}</span></button>
                  {% endif %}
                  {% if block.settings.show_share %}
                    <button type="button" class="www-product__action-link" data-product-share data-share-title="{{ product.title | escape }}" data-share-text="{{ product.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="M8.3 10.9l7.4-4.6M8.3 13.1l7.4 4.6"></path></svg><span data-share-label>{{ block.settings.share_label }}</span></button>
                  {% endif %}
                </div>

              {% when 'delivery_shipping' %}
                <div class="www-product__block www-product__delivery-shipping" style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px; --confidence-font-size: {{ block.settings.font_size }}px; --confidence-icon-size: {{ block.settings.icon_size }}px; --confidence-row-gap: {{ block.settings.row_gap }}px; --confidence-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
                  {% if block.settings.show_top_divider %}<div class="www-product__confidence-divider" aria-hidden="true"></div>{% endif %}
                  <div class="www-product__confidence-rows">
                    {% if localization.country.iso_code == 'GB' %}
                      {% if block.settings.show_delivery_estimate %}
                        <div class="www-product__confidence-row" data-uk-delivery data-min-days="{{ block.settings.delivery_min_days }}" data-max-days="{{ block.settings.delivery_max_days }}" data-business-days="{{ block.settings.business_days }}" data-date-locale="en-GB"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v11H3zM14 9h4l3 3v5h-7z"></path><circle cx="7" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg><div><strong>{{ block.settings.delivery_heading }}</strong><span data-delivery-range>{{ block.settings.delivery_loading_text }}</span></div></div>
                      {% endif %}
                    {% else %}
                      {% if block.settings.show_international %}
                        <div class="www-product__confidence-row"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3 4 6 4 9s-1 6-4 9M12 3c-3 3-4 6-4 9s1 6 4 9"></path></svg><div><strong>{{ block.settings.international_heading }}</strong>{% if block.settings.shipping_policy_page != blank %}<a href="{{ block.settings.shipping_policy_page.url }}">{{ block.settings.international_link_label }}</a>{% else %}<a href="{{ shop.shipping_policy.url }}">{{ block.settings.international_link_label }}</a>{% endif %}</div></div>
                      {% endif %}
                    {% endif %}
                    {% if block.settings.show_free_shipping %}
                      <div class="www-product__confidence-row" data-free-shipping-row data-progress-enabled="{{ block.settings.enable_cart_progress }}" data-threshold-pence="{{ block.settings.free_shipping_threshold | times: 100 }}" data-below-text="{{ block.settings.progress_below_text | escape }}" data-reached-text="{{ block.settings.progress_reached_text | escape }}" data-default-text="{{ block.settings.free_shipping_text | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4zM7 7V4h10v3M4 11h16"></path></svg><div><strong>{{ block.settings.free_shipping_heading }}</strong><span data-free-shipping-text>{{ block.settings.free_shipping_text }}</span></div></div>
                    {% endif %}
                  </div>
                </div>

              {% when 'accordion' %}
                {% liquid
                  assign accordion_content = block.settings.content
                  case block.settings.content_source
                    when 'description'
                      assign accordion_content = product.description
                    when 'product_details'
                      assign accordion_content = product.metafields.custom.product_details
                    when 'wash_care'
                      assign accordion_content = product.metafields.custom.wash_care
                    when 'delivery_payment'
                      assign accordion_content = product.metafields.custom.delivery_payment
                    when 'returns'
                      assign accordion_content = product.metafields.custom.returns
                  endcase
                %}
                {% if accordion_content != blank %}
                  <div
                    class="www-product__block"
                    style="--block-mt: {{ block.settings.margin_top }}px; --block-mb: {{ block.settings.margin_bottom }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <details class="www-product__accordion" {% if block.settings.open_by_default %}open{% endif %}>
                      <summary class="www-product__accordion-summary" style="min-height: {{ block.settings.row_height }}px; font-size: {{ block.settings.heading_size }}px; border-color: {{ block.settings.border_color }};">
                        <span>{{ block.settings.heading }}</span>
                        <span class="www-product__accordion-icon" aria-hidden="true">
                          <svg viewBox="0 0 16 16"><path d="M3 6l5 5 5-5"></path></svg>
                        </span>
                      </summary>
                      <div class="www-product__accordion-content rte" style="font-size: {{ block.settings.content_size }}px; line-height: {{ block.settings.line_height | divided_by: 100.0 }};">
                        {% if block.settings.content_source == 'custom' %}
                          {{ block.settings.content }}
                        {% elsif block.settings.content_source == 'description' %}
                          {{ product.description }}
                        {% else %}
                          {{ accordion_content | metafield_tag }}
                        {% endif %}
                      </div>
                    </details>
                  </div>
                {% endif %}

              {% when '@app' %}
                <div class="www-product__block" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
            {% endcase %}
          {% endfor %}
        {% endform %}
      </div>
    </div>
  </div>

  {% if section.settings.enable_mobile_sticky_atc %}
    <div class="www-product__mobile-bar" data-mobile-bar>
      <div class="www-product__mobile-bar-info">
        <span class="www-product__mobile-bar-title">{{ product.title }}</span>
        <span class="www-product__mobile-bar-price" data-mobile-price>{{ current_variant.price | money }}</span>
      </div>
      <button
        type="button"
        class="www-product__mobile-add"
        data-mobile-add
        data-mobile-add-text="{{ section.settings.mobile_add_text | escape }}"
        data-mobile-select-size-text="{{ section.settings.mobile_select_size_text | escape }}"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {% if current_variant.available %}
          {{ section.settings.mobile_select_size_text }}
        {% else %}
          {{ section.settings.mobile_sold_out_text }}
        {% endif %}
      </button>
    </div>
  {% endif %}

  {% assign question_block = blank %}
  {% for block in section.blocks %}
    {% if block.type == 'product_actions' and block.settings.show_ask_question %}
      {% assign question_block = block %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if question_block != blank %}
    {% assign question_form_id = 'WWWProductQuestion-' | append: section.id %}
    <div class="www-product__question-modal" data-question-modal aria-hidden="true">
      <button type="button" class="www-product__question-overlay" data-question-close aria-label="Close question form"></button>
      <div class="www-product__question-dialog" role="dialog" aria-modal="true" aria-labelledby="www-question-title-{{ section.id }}" style="--question-width: {{ question_block.settings.modal_width }}px; --question-radius: {{ question_block.settings.modal_radius }}px; --question-bg: {{ question_block.settings.modal_background }}; --question-text: {{ question_block.settings.modal_text_color }}; --question-button-bg: {{ question_block.settings.submit_background }}; --question-button-text: {{ question_block.settings.submit_text_color }};">
        <div class="www-product__question-header">
          <div><h2 id="www-question-title-{{ section.id }}">{{ question_block.settings.modal_heading }}</h2>{% if question_block.settings.modal_intro != blank %}<div class="www-product__question-intro rte">{{ question_block.settings.modal_intro }}</div>{% endif %}</div>
          <button type="button" class="www-product__question-close" data-question-close aria-label="Close question form"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg></button>
        </div>
        {% form 'contact', id: question_form_id, class: 'www-product__question-form' %}
          {% if form.posted_successfully? %}<div class="www-product__question-success" role="status">{{ question_block.settings.success_message }}</div>{% endif %}
          {{ form.errors | default_errors }}
          <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[Product URL]" value="{{ shop.url }}{{ product.url }}">
          <input type="hidden" name="contact[Selected variant]" value="{{ current_variant.title | escape }}" data-question-variant>
          <div class="www-product__question-fields">
            <label class="www-product__question-field"><span>{{ question_block.settings.name_label }}</span><input type="text" name="contact[name]" autocomplete="name" required></label>
            <label class="www-product__question-field"><span>{{ question_block.settings.phone_label }}</span><input type="tel" name="contact[phone]" autocomplete="tel"></label>
            <label class="www-product__question-field www-product__question-field--full"><span>{{ question_block.settings.email_label }}</span><input type="email" name="contact[email]" autocomplete="email" required></label>
            <label class="www-product__question-field www-product__question-field--full"><span>{{ question_block.settings.message_label }}</span><textarea name="contact[body]" rows="5" required></textarea></label>
          </div>
          <button type="submit" class="www-product__question-submit">{{ question_block.settings.submit_label }}</button>
        {% endform %}
      </div>
    </div>
  {% endif %}

  {% assign size_guide_page = blank %}
  {% for block in section.blocks %}
    {% if block.type == 'variant_picker' and block.settings.size_guide_page != blank %}
      {% assign size_guide_page = block.settings.size_guide_page %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if size_guide_page != blank %}
    <div class="www-product__drawer" data-size-guide-drawer aria-hidden="true">
      <button type="button" class="www-product__drawer-overlay" data-size-guide-close aria-label="Close size guide"></button>
      <div class="www-product__drawer-panel" role="dialog" aria-modal="true" aria-labelledby="www-size-guide-title-{{ section.id }}">
        <div class="www-product__drawer-header">
          <h2 id="www-size-guide-title-{{ section.id }}">Size guide</h2>
          <button type="button" class="www-product__drawer-close" data-size-guide-close aria-label="Close size guide">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg>
          </button>
        </div>
        <div class="www-product__drawer-content rte">{{ size_guide_page.content }}</div>
      </div>
    </div>
  {% endif %}

  <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>
</section>

<style>
  #www-product-{{ section.id }} {
    --www-gap: {{ section.settings.gallery_gap }}px;
    --www-panel-width: {{ section.settings.panel_width }}%;
    --www-section-bg: {{ section.settings.background_color }};
    --www-text: {{ section.settings.text_color }};
    --www-border: {{ section.settings.border_color }};
    position: relative;
    background: var(--www-section-bg);
    color: var(--www-text);
  }
  #www-product-{{ section.id }} *, #www-product-{{ section.id }} *::before, #www-product-{{ section.id }} *::after { box-sizing: border-box; }
  #www-product-{{ section.id }} .www-product__layout { display: grid; grid-template-columns: minmax(0, calc(100% - var(--www-panel-width))) minmax(390px, var(--www-panel-width)); align-items: start; }
  #www-product-{{ section.id }} .www-product__gallery-wrap { position: relative; min-width: 0; }
  #www-product-{{ section.id }} .www-product__gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--www-gap); padding: var(--www-gap); padding-right: 0; }
  #www-product-{{ section.id }} .www-product__media { min-width: 0; overflow: hidden; background: #ededed; }
  #www-product-{{ section.id }} .www-product__image, #www-product-{{ section.id }} .www-product__video, #www-product-{{ section.id }} .www-product__model, #www-product-{{ section.id }} .www-product__placeholder { display: block; width: 100%; height: auto; min-height: 100%; object-fit: cover; }
  #www-product-{{ section.id }} .www-product__external-video { display: block; width: 100%; aspect-ratio: 3 / 4; border: 0; }
  #www-product-{{ section.id }} .www-product__media { position: relative; }
  #www-product-{{ section.id }} .www-product__zoom-trigger { position:absolute;z-index:3;right:14px;bottom:14px;display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;padding:10px;border:1px solid rgba(0,0,0,.12);border-radius:50%;background:rgba(255,255,255,.88);color:#111;box-shadow:0 4px 18px rgba(0,0,0,.08);cursor:zoom-in;opacity:0;transform:translateY(5px);transition:opacity .2s ease,transform .2s ease,background-color .2s ease;backdrop-filter:blur(8px); }
  #www-product-{{ section.id }} .www-product__media:hover .www-product__zoom-trigger, #www-product-{{ section.id }} .www-product__zoom-trigger:focus-visible { opacity:1;transform:translateY(0); }
  #www-product-{{ section.id }} .www-product__zoom-trigger svg { width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round; }
  #www-product-{{ section.id }} .www-product__lightbox { position:fixed;z-index:10050;inset:0;visibility:hidden;background:{{ section.settings.lightbox_background }};color:{{ section.settings.lightbox_text_color }};opacity:0;pointer-events:none;transition:opacity .22s ease,visibility .22s ease; }
  #www-product-{{ section.id }} .www-product__lightbox.is-open { visibility:visible;opacity:1;pointer-events:auto; }
  #www-product-{{ section.id }} .www-product__lightbox-shell { display:flex;width:100%;height:100%;min-height:0;flex-direction:column; }
  #www-product-{{ section.id }} .www-product__lightbox-topbar { position:relative;z-index:5;display:flex;align-items:center;justify-content:space-between;min-height:66px;padding:12px 20px;border-bottom:1px solid rgba(127,127,127,.22); }
  #www-product-{{ section.id }} .www-product__lightbox-count { font-size:13px;letter-spacing:.04em; }
  #www-product-{{ section.id }} .www-product__lightbox-close { display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;padding:9px;border:0;background:transparent;color:inherit;cursor:pointer; }
  #www-product-{{ section.id }} .www-product__lightbox-close svg, #www-product-{{ section.id }} .www-product__lightbox-arrow svg { width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round; }
  #www-product-{{ section.id }} .www-product__lightbox-body { display:grid;min-height:0;flex:1;grid-template-columns:{% if section.settings.show_lightbox_thumbnails and media_count > 1 %}96px minmax(0,1fr){% else %}minmax(0,1fr){% endif %}; }
  #www-product-{{ section.id }} .www-product__lightbox-thumbnails { display:flex;min-height:0;flex-direction:column;gap:10px;padding:16px 12px;overflow-y:auto;border-right:1px solid rgba(127,127,127,.22);scrollbar-width:thin; }
  #www-product-{{ section.id }} .www-product__lightbox-thumbnail { position:relative;flex:0 0 auto;width:72px;aspect-ratio:3/4;padding:0;overflow:hidden;border:1px solid transparent;background:rgba(127,127,127,.12);opacity:.58;cursor:pointer;transition:opacity .18s ease,border-color .18s ease; }
  #www-product-{{ section.id }} .www-product__lightbox-thumbnail:hover, #www-product-{{ section.id }} .www-product__lightbox-thumbnail.is-active { border-color:currentColor;opacity:1; }
  #www-product-{{ section.id }} .www-product__lightbox-thumbnail-image { display:block;width:100%;height:100%;object-fit:cover; }
  #www-product-{{ section.id }} .www-product__lightbox-thumbnail-play { position:absolute;inset:50% auto auto 50%;display:inline-flex;width:26px;height:26px;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.88);color:#111;transform:translate(-50%,-50%); }
  #www-product-{{ section.id }} .www-product__lightbox-thumbnail-play svg { width:14px;height:14px;fill:currentColor; }
  #www-product-{{ section.id }} .www-product__lightbox-stage-wrap { position:relative;min-width:0;min-height:0;overflow:hidden; }
  #www-product-{{ section.id }} .www-product__lightbox-stage { position:relative;width:100%;height:100%;min-height:0;touch-action:pan-y pinch-zoom; }
  #www-product-{{ section.id }} .www-product__lightbox-slide { position:absolute;inset:0;display:none;align-items:center;justify-content:center;padding:24px 84px;overflow:hidden; }
  #www-product-{{ section.id }} .www-product__lightbox-slide.is-active { display:flex; }
  #www-product-{{ section.id }} .www-product__lightbox-image-wrap { display:flex;width:100%;height:100%;align-items:center;justify-content:center;overflow:auto;cursor:zoom-in;scrollbar-width:none; }
  #www-product-{{ section.id }} .www-product__lightbox-image-wrap::-webkit-scrollbar { display:none; }
  #www-product-{{ section.id }} .www-product__lightbox-image { display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;user-select:none;-webkit-user-drag:none; }
  #www-product-{{ section.id }} .www-product__lightbox-image-wrap.is-zoomed { align-items:flex-start;justify-content:flex-start;cursor:zoom-out; }
  #www-product-{{ section.id }} .www-product__lightbox-image-wrap.is-zoomed .www-product__lightbox-image { max-width:none;max-height:none;width:180%;height:auto; }
  #www-product-{{ section.id }} .www-product__lightbox-video, #www-product-{{ section.id }} .www-product__lightbox-model { display:block;max-width:100%;max-height:100%;width:auto;height:auto; }
  #www-product-{{ section.id }} .www-product__lightbox-external-wrap { width:min(1180px,100%);aspect-ratio:16/9; }
  #www-product-{{ section.id }} .www-product__lightbox-external-video { display:block;width:100%;height:100%;border:0; }
  #www-product-{{ section.id }} .www-product__lightbox-arrow { position:absolute;z-index:4;top:50%;display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;padding:12px;border:1px solid rgba(127,127,127,.28);border-radius:50%;background:rgba(255,255,255,.86);color:#111;cursor:pointer;transform:translateY(-50%);backdrop-filter:blur(8px); }
  #www-product-{{ section.id }} .www-product__lightbox-arrow--previous { left:20px; }
  #www-product-{{ section.id }} .www-product__lightbox-arrow--next { right:20px; }
  #www-product-{{ section.id }} .www-product__lightbox-help { min-height:38px;padding:10px 20px;border-top:1px solid rgba(127,127,127,.22);font-size:11px;text-align:center;opacity:.65; }
  html.www-product-lightbox-open, html.www-product-lightbox-open body { overflow:hidden!important;overscroll-behavior:none; }
  #www-product-{{ section.id }} .www-product__pagination { display: none; }
  #www-product-{{ section.id }},
  #www-product-{{ section.id }} .www-product__layout,
  #www-product-{{ section.id }} .www-product__gallery-wrap,
  #www-product-{{ section.id }} .www-product__panel {
    overflow: visible;
  }

  #www-product-{{ section.id }} .www-product__panel {
    position: relative;
    align-self: stretch;
    min-width: 0;
  }

  #www-product-{{ section.id }} .www-product__panel-inner {
    position: relative;
    width: 100%;
    padding:
      calc(var(--www-gap) + {{ section.settings.panel_top_offset }}px)
      {{ section.settings.panel_side_padding }}px
      {{ section.settings.panel_padding_bottom }}px;
  }

  #www-product-{{ section.id }} .www-product__panel-inner.is-fixed {
    position: fixed;
    z-index: 30;
    top: var(--www-sticky-top, 0px);
    left: var(--www-sticky-left, 0px);
    width: var(--www-sticky-width, auto);
    max-height: calc(100vh - var(--www-sticky-top, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  #www-product-{{ section.id }} .www-product__panel-inner.is-bottom {
    position: absolute;
    z-index: 2;
    top: auto;
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    max-height: none;
    overflow: visible;
  }
  #www-product-{{ section.id }} .www-product__block { margin-top: var(--block-mt, 0); margin-bottom: var(--block-mb, 0); }
  #www-product-{{ section.id }} .www-product__text-left, #www-product-{{ section.id }} .www-product__align-left { text-align: left; }
  #www-product-{{ section.id }} .www-product__text-center, #www-product-{{ section.id }} .www-product__align-center { text-align: center; }
  #www-product-{{ section.id }} .www-product__text-right, #www-product-{{ section.id }} .www-product__align-right { text-align: right; }
  #www-product-{{ section.id }} .www-product__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    color: rgba(0,0,0,.62);
    font-size: 13px;
    line-height: 1.4;
  }
  #www-product-{{ section.id }} .www-product__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }
  #www-product-{{ section.id }} .www-product__breadcrumbs a:hover {
    color: var(--www-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #www-product-{{ section.id }} .www-product__breadcrumb-current {
    min-width: 0;
    overflow: hidden;
    color: var(--www-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #www-product-{{ section.id }} .www-product__breadcrumb-separator {
    flex: 0 0 auto;
    opacity: .55;
  }
  #www-product-{{ section.id }} .www-product__wishlist { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; padding: 0; border: 0; background: transparent; color: currentColor; cursor: pointer; }
  #www-product-{{ section.id }} .www-product__wishlist svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.7; }
  #www-product-{{ section.id }} .www-product__wishlist.is-active svg { fill: currentColor; }
  #www-product-{{ section.id }} .www-product__title { margin: 0; color: var(--title-color); font-size: var(--title-size); font-weight: var(--title-weight); line-height: var(--title-line-height); letter-spacing: -.025em; }
  #www-product-{{ section.id }} .www-product__price { color: var(--price-color); font-size: var(--price-size); line-height: 1.2; }
  #www-product-{{ section.id }} .www-product__compare-price { margin-top: 3px; color: rgba(0,0,0,.55); font-size: 13px; text-decoration: line-through; }
  #www-product-{{ section.id }} .www-product__tax-text { margin-top: 4px; color: rgba(0,0,0,.52); font-size: 12px; }
  #www-product-{{ section.id }} .www-product__colour-products { margin: 0; padding: 0; border: 0; }
  #www-product-{{ section.id }} .www-product__colour-products > .www-product__option-label { display: block; margin: 0 0 11px; }
  #www-product-{{ section.id }} .www-product__colour-product-list { display: flex; flex-wrap: wrap; gap: var(--variant-gap, 8px); }
  #www-product-{{ section.id }} .www-product__colour-product {
    display: block;
    width: calc(var(--colour-thumbnail-size, 44px) + 10px);
    aspect-ratio: 2 / 3;
    padding: 4px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--colour-thumbnail-radius, 0px);
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: border-color .18s ease, opacity .18s ease;
  }
  #www-product-{{ section.id }} .www-product__colour-product:hover { border-color: rgba(0,0,0,.42); }
