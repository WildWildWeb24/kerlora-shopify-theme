        "story_card_JT98iJ": {
          "type": "story_card",
          "settings": {
            "customer_image": "shopify://shop_images/WhatsApp_Image_2026-10-05_at_17.48.41.jpg",
            "star_rating": 5,
            "quote": "I’m In love with this sweatshirt. It really lives up to its name “classic” — the cut is simple and timeless, easy to pair with jeans or a skirt, or leggings and it skims the hips just right without pulling or clinging. The fabric feels rich and buttery, and it’s vibrant! The red is bold enough to lift an outfit, but not too “shouty” . As a middle-aged woman, I’m not one for loud logos or branding plastered all over clothes: I love that the only badge of branding is a subtle little tab on the side seam — discreet, elegant and perfectly in keeping with a more refined style.\n\nIt’s comfortable enough for a quick gym drop-in, a weekend walk, but equally easy to dress up a little if I fancy a casual-chic coffee date. In short: classy, comfy and practical , it’s exactly what I wanted. I’d happily recommend it to anyone who likes their casual wear to feel grown-up but not fussy 🫶♥️",
            "customer_name": "Emma H.",
            "customer_location": "",
            "tagged_product": "red-classic-sweatshirt",
            "demo_product_title": "Serene Sports Bra"
          }
        },
        "story_card_6i4eHf": {
