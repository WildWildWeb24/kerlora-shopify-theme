    "real_customer_stories_Q97E8p": {
      "type": "real-customer-stories",
      "blocks": {
        "story_card_EpMnjr": {
          "type": "story_card",
          "settings": {
            "customer_image": "shopify://shop_images/sharon.webp",
            "star_rating": 5,
            "quote": "If you want a set that turns heads while feeling like a literal hug, look no further. I wore mine to a sound healing session and was stopped by almost everyone there asking about them.\nAs a UK size 16, finding loungewear that makes me feel genuinely confident and stylish can be a challenge, but the cut is so flattering. The fleece lining kept me perfectly cozy during meditation, it felt like being on a cloud.",
            "customer_name": "Sharon Varker",
            "customer_location": "",
            "tagged_product": "grey-wide-leg-fleece-lined-lounge-joggers",
            "demo_product_title": "Serene Sports Bra"
          }
        },
        "story_card_Cwcmre": {
          "type": "story_card",
          "settings": {
            "customer_image": "shopify://shop_images/vickie.webp",
            "star_rating": 5,
            "quote": "I absolutely love these gym leggings! They stay firmly in place while exercising and don’t roll down or need constant adjusting, even during more intense workouts. They’re comfortable, stretchy, and supportive without feeling too tight. Definitely one of the best pairs of leggings I’ve tried for the gym!",
            "customer_name": "Vickie",
            "customer_location": "",
            "tagged_product": "black-essential-leggings",
            "demo_product_title": "Serene Sports Bra"
          }
        },
        "story_card_aYkTUp": {
          "type": "story_card",
          "settings": {
            "customer_image": "shopify://shop_images/WhatsApp_Image_2026-10-06_at_01.12.43.jpg",
            "star_rating": 5,
            "quote": "This set is my absolute favourite. Fits perfectly and so comfy, have received lots of compliments when wearing it!",
            "customer_name": "Sarah Jayne",
            "customer_location": "",
