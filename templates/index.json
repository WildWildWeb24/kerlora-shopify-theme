          "settings": {
            "customer_image": "shopify://shop_images/WhatsApp_Image_2026-10-05_at_16.51.21.jpg",
            "star_rating": 5,
            "quote": "I bought these shorts not only for daily exercise but also for my recent holiday (I knew there would be a lot of walking). They are so light and really comfortable to wear. I would highly recommend.",
            "customer_name": "Sara",
            "customer_location": "",
            "tagged_product": "tangerine-4-high-rise-shorts-with-liner",
            "demo_product_title": "Serene Sports Bra"
          }
        },
        "story_card_rwLHkz": {
          "type": "story_card",
          "settings": {
            "customer_image": "shopify://shop_images/Gemma.webp",
            "star_rating": 5,
            "quote": "This gym set is so comfortable! I love the style/fit and I had lots of compliments on the colour. It is the perfect gym outfit or even just casual wear. I have worn to gym & gym class and it is squat-proof! Really nice supportive waistband that didn’t roll down at all.\nThe material is soft and comfortable and feels durable. I will be purchasing in every colour!! Thank you!!!",
            "customer_name": "Gemma Winter",
