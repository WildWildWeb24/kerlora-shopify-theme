            "button_link": "",
            "button_style": "m-button--link",
            "button_size": ""
          }
        },
        "iconbox_MhLMn3": {
          "type": "iconbox",
          "settings": {
            "image": "shopify://shop_images/kerlora-about-us-ethical-promise.png",
            "image_by_url": "",
            "title": "Ethical Promise",
            "description": "<p>At Kerlora we are committed to responsible sourcing. Each and every supplier we work with are SEDEX approved, thus meeting high standards for ethical and responsible production. This ranges from ensuring fair working conditions and  safe environments to full transparency throughout the supply chain. <br/>As a small brand we always ensure mindful small batch production. Each piece is intentionally designed to be long lasting and so catering to demand rather than overconsumption has been a key business decision. </p>",
            "link": "",
            "button_label": "",
            "button_link": "",
            "button_style": "m-button--link",
            "button_size": ""
          }
        }
      },
