        "text_color": "white",
        "title": "Find strength in movement, not perfection",
        "subtitle": "",
        "text": "<p>At Kerlora we know the power of mindful movement. Whether that's a morning stroll, your favourite gym class or a strength training session, Kerlora has been built with movement in mind. Get to know more about us. </p>",
        "button_label": "",
        "button_link": "",
        "button_style": "m-button--primary",
        "button_size": "",
        "text_alignment_mobile": "left",
        "mb_image": "shopify://shop_images/kerlora-about-us-01-desktop.jpg",
