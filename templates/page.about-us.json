        "iconbox_yV9Bfi": {
          "type": "iconbox",
          "settings": {
            "image": "shopify://shop_images/kerlora-about-us-design-craftsmanship.png",
            "image_by_url": "",
            "title": "Design & Craftsmanship",
            "description": "<p>Each and every Kerlora piece has been intentionally designed for the real body. When we feel comfortable, movement becomes easier and more effortless. And so comfort, ease and support have guided each design decision, leading to a collection of long lasting pieces that make you feel your best each and every time you wear them. From the choice of fabrics to the construction of each garment, at Kerlora we have consciously crafted each piece for the real woman.</p>",
            "link": "",
